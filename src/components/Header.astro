---
import BrandMark from '~/components/BrandMark.astro';
import ThemeToggle from '~/components/ThemeToggle.astro';

const navLinks = [
  { href: '/foundations', label: 'Foundations' },
  { href: '/safety-pipeline', label: 'Safety Pipeline' },
  { href: '/agents', label: 'Agents' },
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/responsible-adoption', label: 'Responsible Adoption' },
  { href: '/tracker', label: 'Regulatory Tracker' },
  { href: '/road-ahead', label: 'Road Ahead' },
  { href: '/glossary', label: 'Glossary' },
  { href: '/about', label: 'About' },
];

// Current pathname for aria-current highlighting.
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const normalised = href.replace(/\/$/, '') || '/';
  if (normalised === '/') return pathname === '/';
  return pathname === normalised || pathname.startsWith(normalised + '/');
};
---

<header class="site-header">
  <div class="wrap nav-in">
    <div class="nav-left">
      <button
        type="button"
        id="menu-toggle"
        class="burger"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="drawer-nav"
      >
        <span></span><span></span><span></span>
      </button>

      <a href="/" class="brand" aria-label="Medivora — home">
        <BrandMark size={40} class="brand-mark" />
        <span class="brand-name">Medivora</span>
      </a>
    </div>

    <div class="nav-tools">
      <!-- Search button -->
      <button
        type="button"
        id="search-btn"
        class="search-btn"
        aria-label="Search (Cmd+K)"
        title="Search (Cmd+K)"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.8"/>
          <path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <kbd class="search-btn-hint">⌘K</kbd>
      </button>
      <ThemeToggle />
      <a href="/contact" class="nav-cta">Get in touch →</a>
    </div>
  </div>

  <!-- Backdrop overlay -->
  <div id="drawer-backdrop" class="drawer-backdrop"></div>

  <!-- Left Sliding Drawer -->
  <nav id="drawer-nav" class="drawer-nav" aria-label="Main Navigation">
    <div class="drawer-header">
      <BrandMark size={32} class="brand-mark" />
      <span class="brand-name" style="font-size: 1.1rem;">Menu</span>
      <button id="drawer-close" class="drawer-close" aria-label="Close menu">&times;</button>
    </div>
    <div class="drawer-scroll-area">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li style="margin-top: 1.5rem;">
          <a href="/contact" class="drawer-cta">Get in touch →</a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
  }
  .nav-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 66px;
    gap: 1.5rem;
  }
  .nav-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.22rem;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .brand-mark {
    width: 40px;
    height: 40px;
    flex: none;
    transition: transform 250ms cubic-bezier(.34,1.56,.64,1);
  }
  .brand:hover .brand-mark {
    transform: scale(1.1) rotate(-4deg);
  }

  .nav-tools {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .nav-cta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid var(--color-text);
    color: var(--color-text);
    padding: 9px 16px;
    border-radius: var(--radius-xs);
    transition: background-color 180ms ease, color 180ms ease;
  }
  .nav-cta:hover {
    background-color: var(--color-text);
    color: var(--color-bg);
  }
  @media (max-width: 600px) {
    .nav-cta { display: none; }
  }

  /* Search button */
  .search-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    padding: 6px 10px;
    color: var(--color-text-soft);
    cursor: pointer;
    transition: color 180ms ease, border-color 180ms ease, background-color 180ms ease;
  }
  .search-btn:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
    background-color: var(--color-surface);
  }
  .search-btn-hint {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    padding: 1px 4px;
    border: 1px solid var(--color-line);
    border-radius: 3px;
    background-color: var(--color-surface-2);
    color: var(--color-text-soft);
  }
  @media (max-width: 980px) {
    .search-btn-hint { display: none; }
  }

  /* Burger Menu Button */
  .burger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 8px;
    margin-left: -8px; /* Alignment adjust */
  }
  .burger span {
    width: 22px;
    height: 2px;
    background-color: var(--color-text);
    transition: transform 240ms ease, opacity 240ms ease;
  }
  .burger:hover span {
    background-color: var(--color-accent);
  }

  /* Drawer Overlay */
  .drawer-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 99;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }
  .drawer-backdrop.active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Left Sliding Drawer */
  .drawer-nav {
    position: fixed;
    top: 0;
    left: -320px;
    width: 320px;
    height: 100vh;
    background-color: var(--color-surface);
    border-right: 1px solid var(--color-line);
    z-index: 100;
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    box-shadow: 10px 0 30px rgba(0,0,0,0.5);
  }
  .drawer-nav.open {
    transform: translateX(320px);
  }
  @media (max-width: 400px) {
    .drawer-nav {
      width: 100vw;
      left: -100vw;
    }
    .drawer-nav.open {
      transform: translateX(100vw);
    }
  }

  .drawer-header {
    display: flex;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--color-line);
    gap: 0.5rem;
  }
  .drawer-close {
    margin-left: auto;
    background: none;
    border: none;
    font-size: 2rem;
    color: var(--color-text-soft);
    cursor: pointer;
    line-height: 1;
    transition: color 200ms ease;
  }
  .drawer-close:hover {
    color: var(--color-accent);
  }

  .drawer-scroll-area {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }
  .drawer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .drawer-nav a {
    display: block;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--color-text-2);
    transition: background-color 200ms ease, color 200ms ease;
  }
  .drawer-nav a:hover {
    background-color: rgba(255,255,255,0.05);
    color: var(--color-text);
  }
  .drawer-nav a[aria-current='page'] {
    background-color: rgba(59,130,246,0.1);
    color: var(--color-accent);
  }
  .drawer-cta {
    display: inline-block;
    width: 100%;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background-color: var(--color-text);
    color: var(--color-bg) !important;
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    font-weight: 600 !important;
  }
  .drawer-cta:hover {
    background-color: var(--color-text-soft);
  }
</style>

<script is:inline>
  (function () {
    const btn = document.getElementById('menu-toggle');
    const closeBtn = document.getElementById('drawer-close');
    const menu = document.getElementById('drawer-nav');
    const backdrop = document.getElementById('drawer-backdrop');
    
    if (!btn || !menu || !backdrop || !closeBtn) return;
    
    const openMenu = () => {
      menu.classList.add('open');
      backdrop.classList.add('active');
      document.body.style.overflow = 'hidden'; // Prevent background scrolling
    };

    const closeMenu = () => {
      menu.classList.remove('open');
      backdrop.classList.remove('active');
      document.body.style.overflow = '';
    };

    btn.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);
    backdrop.addEventListener('click', closeMenu);

    // Close menu on link click
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', closeMenu)
    );
    
    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('open')) {
        closeMenu();
      }
    });
  })();
</script>
