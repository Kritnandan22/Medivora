---
import BaseLayout from '~/layouts/BaseLayout.astro';

const coverageAreas = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>`,
    title: 'Case Intake & Triage',
    desc: 'Automating the extraction of the four valid ICSR elements from unstructured source documents, emails, and faxes to eliminate manual data entry.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16c0 1.1.9 2 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/><path d="M14 3v5h5M16 13H8M16 17H8M10 9H8"/></svg>`,
    title: 'Data & Narrative Extraction',
    desc: 'Using LLMs to pull clinical facts, timelines, and lab results from messy patient narratives, distinguishing primary adverse events from medical history.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
    title: 'MedDRA & WHO-DD Coding',
    desc: 'Applying semantic reasoning to code verbatim terms against MedDRA dictionaries, drastically reducing the manual burden on medical coders.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
    title: 'Seriousness & Expectedness',
    desc: 'Cross-referencing core data sheets to determine if events trigger expedited reporting, ensuring 100% compliance with 15-day rules.',
  },
];

const principles = [
  { num: '01', title: 'Clinical Accuracy', desc: 'Every technical claim is grounded in peer-reviewed literature, regulatory guidance documents, or validated industry reports.' },
  { num: '02', title: 'Vendor Neutrality', desc: 'Medivora is independent of all technology vendors. No product recommendation reflects a commercial arrangement.' },
  { num: '03', title: 'Regulatory Fidelity', desc: 'Content reflects the current PV frameworks of the FDA, EMA, PMDA, and ICH (e.g., E2B R3, GVP Module VI).' },
  { num: '04', title: 'Practitioner Primacy', desc: 'Written for the practitioner, not the regulator or the investor. We prioritise operational clarity over theoretical completeness.' },
  { num: '05', title: 'Transparent Limitations', desc: 'AI in PV has unsolved problems. Medivora does not suppress failure cases, hallucination risks, or unresolved debates.' },
  { num: '06', title: 'Living Document', desc: 'Content is reviewed and updated as the evidence base, regulatory landscape, and deployed technology shift.' },
];

const audience = [
  { title: 'Drug Safety & PV Operations', items: ['VP/Director of Pharmacovigilance', 'PV Operations Managers', 'Case Processing Leads', 'Safety Systems IT'] },
  { title: 'Medical & Clinical Safety', items: ['Drug Safety Physicians', 'Medical Reviewers', 'Qualified Persons for PV (QPPV)', 'Clinical Safety Scientists'] },
  { title: 'Regulatory & Compliance', items: ['Regulatory Affairs Directors', 'PV QA Auditors', 'Compliance Officers', 'Submission Strategists'] },
  { title: 'Data Management', items: ['Medical Coders', 'Safety Database Administrators', 'Clinical Data Managers'] },
];

const roadmap = [
  { phase: 'Current', label: 'PV Frameworks', desc: 'All foundational content, the safety pipeline guides, and PV agent blueprints — freely accessible.', status: 'live' },
  { phase: 'Q3 2026', label: 'Signal Detection', desc: 'Expanding coverage to proactive signal detection across EHR, literature, and real-world evidence.', status: 'soon' },
  { phase: '2027', label: 'Aggregate Reporting', desc: 'Guides for automating PSUR, PBRER, and DSUR drafting using generative agent architectures.', status: 'planned' },
];
---

<BaseLayout
  title="About Medivora"
  description="Medivora is an independent intelligence platform providing evidence-based analysis of Agentic AI in Pharmacovigilance and Drug Safety."
>

  <!-- ── Publication Masthead ── -->
  <section class="masthead">
    <div class="wrap">
      <div class="masthead-inner">
        <div class="masthead-identity">
          <span class="pub-tag">Independent PV Intelligence Platform</span>
          <h1>About <em>Medivora</em></h1>
          <p class="masthead-mission">
            A peer-informed, editorially independent reference for practitioners navigating
            the application of artificial intelligence and automation in Pharmacovigilance
            and the ICSR lifecycle.
          </p>
          <div class="masthead-meta">
            <div class="meta-item">
               <span class="meta-label">Coverage</span>
               <span class="meta-val">Pharmacovigilance · Drug Safety · AI Case Processing</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Audience</span>
              <span class="meta-val">Drug Safety Physicians, PV Operations, QPPVs</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Access</span>
              <span class="meta-val">Free foundational content & open blueprints</span>
            </div>
          </div>
        </div>
        <div class="masthead-card">
          <div class="mc-stat"><span class="mcs-n">7</span><span class="mcs-l">ICSR lifecycle stages mapped</span></div>
          <div class="mc-stat"><span class="mcs-n">6</span><span class="mcs-l">PV specialist agents detailed</span></div>
          <div class="mc-stat"><span class="mcs-n">10+</span><span class="mcs-l">Regulatory frameworks covered</span></div>
          <div class="mc-stat"><span class="mcs-n">0</span><span class="mcs-l">Vendor relationships. Zero.</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Editorial Mission ── -->
  <section class="mission-section">
    <div class="wrap mission-grid">
      <div class="mission-left">
        <span class="eyebrow">Editorial Mission</span>
        <h2>The gap this publication fills</h2>
        <p>
          The application of AI to pharmacovigilance is advancing faster than the practitioner
          literature that should explain it. Vendor documentation describes products. Academic papers
          describe experiments. Neither reliably answers the operational question that matters most
          to the professional in the field: <em>what does this actually mean for how we process safety cases?</em>
        </p>
        <p>
          Medivora occupies the space between those two bodies of literature. It translates
          clinical AI research and regulatory frameworks into operational knowledge — grounded
          in the specific contexts of ICH E2B, MedDRA coding, and expedited reporting — for the practitioners and decision-makers who implement these systems.
        </p>
        <p>
          This is not an advocacy publication. We do not promote the rapid adoption of AI without rigorous validation. We provide the accurate technical and contextual knowledge that
          enables informed, evidence-based decisions about when adoption is appropriate,
          what it requires, and what it risks.
        </p>
      </div>
      <div class="mission-right">
        <div class="independence-box">
          <div class="ib-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Editorial Independence</span>
          </div>
          <p>Medivora accepts no advertising, no sponsored content, no vendor partnerships, and no affiliate revenue of any kind. All content is produced solely on the basis of editorial merit and clinical relevance.</p>
          <div class="ib-divider"></div>
          <div class="ib-row">
            <span class="ib-no">✗</span>
            <span>Sponsored articles or "native advertising"</span>
          </div>
          <div class="ib-row">
            <span class="ib-row">
            <span class="ib-no">✗</span>
            <span>Product recommendations for commercial consideration</span>
          </div>
          <div class="ib-row">
            <span class="ib-no">✗</span>
            <span>Equity positions in any company mentioned</span>
          </div>
          <div class="ib-row">
            <span class="ib-no">✗</span>
            <span>Consulting relationships with profiled organisations</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Coverage Scope ── -->
  <section class="coverage-section">
    <div class="wrap">
      <div class="coverage-head">
        <span class="eyebrow">Scope of Coverage</span>
        <h2>The Pharmacovigilance AI Landscape</h2>
        <p class="coverage-sub">
          Medivora is focused exclusively on the application of agentic automation within Pharmacovigilance. We dissect the ICSR lifecycle step-by-step to understand where AI works today, and where it falls short.
        </p>
      </div>
      <div class="coverage-grid">
        {coverageAreas.map((area, i) => (
          <article class="cov-card">
            <div class="cov-icon" set:html={area.icon} />
            <div class="cov-body">
              <h3>{area.title}</h3>
              <p>{area.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Editorial Principles ── -->
  <section class="principles-section">
    <div class="wrap">
      <span class="eyebrow">Editorial Principles</span>
      <h2>How content is produced and reviewed</h2>
      <div class="principles-grid">
        {principles.map(p => (
          <div class="principle-item">
            <span class="prin-num">{p.num}</span>
            <div class="prin-body">
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Team / Authors ── -->
  <section class="team-section">
    <div class="wrap">
      <span class="eyebrow">Who is behind Medivora</span>
      <h2>Founder & Lead Architect</h2>
      <div class="team-grid">
        <div class="team-member">
          <h3>Kritnandan</h3>
          <span class="team-role">Founder</span>
          <p>Holding a B.Tech in Biological Sciences and Bioengineering from IIT Kanpur, Kritnandan brings extensive cross-disciplinary expertise spanning Data Science, Computational Biology, and Biostatistics. As the Founder, he drives the technical and strategic vision for Medivora. He was recognized as the third-place winner of the Novartis NEST 1.0 Hackathon for pioneering predictive models to forecast clinical trial recruitment rates.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Intended Audience ── -->
  <section class="audience-section">
    <div class="wrap">
      <span class="eyebrow">Intended Readership</span>
      <h2>Written for practitioners, not for the general public</h2>
      <p class="aud-intro">
        Content assumes familiarity with pharmacovigilance processes and safety databases. It does not require technical AI expertise — that is what the guide provides.
        It does require operational context: an understanding of what MedDRA coding is, what expectedness means, and why expedited reporting matters.
      </p>
      <div class="audience-grid">
        {audience.map(group => (
          <div class="aud-group">
            <h3 class="aud-group-title">{group.title}</h3>
            <ul class="aud-list">
              {group.items.map(item => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Access Roadmap ── -->
  <section class="roadmap-section">
    <div class="wrap">
      <span class="eyebrow">Access & Development Roadmap</span>
      <h2>Where we are heading</h2>
      <p class="roadmap-intro">
        We are starting with the core ICSR processing pipeline. In the future, we will expand our technical coverage into complex PV workflows like aggregate reporting and signal detection.
      </p>
      <div class="roadmap-track">
        {roadmap.map((item, i) => (
          <div class={`roadmap-item ri-${item.status}`}>
            <div class="ri-phase">
              <span class="ri-phase-label">{item.phase}</span>
              {item.status === 'live' && <span class="ri-badge live-badge">Live</span>}
              {item.status === 'soon' && <span class="ri-badge soon-badge">Soon</span>}
              {item.status === 'planned' && <span class="ri-badge plan-badge">Planned</span>}
            </div>
            <div class="ri-connector" />
            <div class="ri-content">
              <h3>{item.label}</h3>
              <p>{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Contribute / Contact ── -->
  <section class="contact-section">
    <div class="wrap contact-inner">
      <div class="contact-text">
        <span class="eyebrow">Corrections & Contributions</span>
        <h2>PV knowledge is a collaborative project</h2>
        <p>
          If you identify an error — factual, regulatory, or technical — we want to know immediately.
          If you are a practitioner with direct operational experience in drug safety
          and are willing to review content for accuracy, we are interested in hearing from you.
        </p>
        <p>
          Medivora's credibility depends on getting the PV details right. Reader challenge
          is part of the editorial process, not an exception to it.
        </p>
        <div class="contact-actions">
          <a href="/contact" class="btn-primary">Submit a correction or contribution →</a>
          <a href="/glossary" class="btn-ghost-light">Browse the glossary</a>
        </div>
      </div>
      <div class="contact-disclaimer">
        <h3>Medical Disclaimer</h3>
        <p>
          Content published by Medivora is intended for informational and professional
          education purposes only. It does not constitute medical advice, clinical guidance,
          or regulatory counsel for any specific situation. Practitioners should apply
          professional judgement and consult applicable regulatory authorities before
          implementing any automated system in a clinical or GxP environment.
        </p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Masthead ── */
  .masthead {
    background-color: #0a1510;
    border-bottom: 1px solid rgba(22,166,132,.25);
    padding: 5rem 0 4rem;
  }
  .masthead-inner {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: 4rem;
    align-items: start;
  }
  .pub-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-green-bright);
    border: 1px solid rgba(22,166,132,.4);
    padding: 4px 12px;
    border-radius: var(--radius-xs);
    margin-bottom: 1.2rem;
  }
  .masthead h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 6vw, 4.8rem);
    line-height: 1.0;
    letter-spacing: -0.03em;
    color: #f1ece0;
    margin-bottom: 1.4rem;
  }
  .masthead h1 em { color: var(--color-green-bright); font-style: italic; }
  .masthead-mission {
    font-size: 1.05rem;
    color: rgba(241,236,224,.72);
    line-height: 1.65;
    max-width: 58em;
    margin-bottom: 2rem;
    font-style: italic;
  }
  .masthead-meta { display: flex; flex-direction: column; gap: 0.8rem; }
  .meta-item { display: flex; gap: 1rem; align-items: baseline; font-size: 0.84rem; }
  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(241,236,224,.4);
    min-width: 5.5rem;
    flex: none;
  }
  .meta-val { color: rgba(241,236,224,.75); line-height: 1.4; }

  .masthead-card {
    background: rgba(22,166,132,.08);
    border: 1px solid rgba(22,166,132,.22);
    border-radius: var(--radius-md);
    padding: 1.8rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .mc-stat {}
  .mcs-n {
    display: block;
    font-family: var(--font-serif);
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--color-green-bright);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .mcs-l {
    display: block;
    font-size: 0.78rem;
    color: rgba(241,236,224,.55);
    margin-top: 0.3rem;
    line-height: 1.35;
  }

  /* ── Mission ── */
  .mission-section {
    padding: 5rem 0;
    border-bottom: 1px solid var(--color-line-soft);
  }
  .mission-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: start;
  }
  .mission-left .eyebrow { margin-bottom: 0.8rem; display: block; }
  .mission-left h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 1.6rem;
    line-height: 1.1;
  }
  .mission-left p {
    font-size: 1rem;
    color: var(--color-text-2);
    line-height: 1.75;
    margin-bottom: 1.2rem;
  }
  .mission-left em { color: var(--color-text); font-style: italic; }

  .independence-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-md);
    padding: 1.8rem;
  }
  .ib-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-text);
    margin-bottom: 0.9rem;
  }
  .ib-header svg { color: var(--color-accent); }
  .independence-box > p {
    font-size: 0.88rem;
    color: var(--color-text-2);
    line-height: 1.6;
    margin-bottom: 1.2rem;
  }
  .ib-divider { border-top: 1px solid var(--color-line-soft); margin: 1rem 0; }
  .ib-row {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    margin-bottom: 0.55rem;
    font-size: 0.84rem;
    color: var(--color-text-2);
    line-height: 1.35;
  }
  .ib-no { color: #c06a24; font-weight: 700; flex: none; }
  .ib-yes { color: #16a684; font-weight: 700; flex: none; }

  /* ── Coverage ── */
  .coverage-section {
    padding: 5rem 0;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-line-soft);
  }
  .coverage-head { margin-bottom: 2.8rem; }
  .coverage-head .eyebrow { margin-bottom: 0.6rem; display: block; }
  .coverage-head h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
    line-height: 1.1;
  }
  .coverage-sub {
    font-size: 0.98rem;
    color: var(--color-text-2);
    line-height: 1.65;
    max-width: 62em;
  }
  .coverage-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
  }
  .cov-card {
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
    background: color-mix(in srgb, var(--color-surface) 60%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(241, 236, 224, 0.1);
    border-radius: var(--radius-lg);
    padding: 2rem;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, border-color 0.4s ease;
  }
  .cov-card:hover { border-color: rgba(241, 236, 224, 0.2); transform: translateY(-4px); box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2); }
  .cov-icon {
    color: var(--color-accent);
    flex: none;
    width: 28px;
    margin-top: 2px;
  }
  .cov-body h3 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.45rem;
  }
  .cov-body p {
    font-size: 0.84rem;
    color: var(--color-text-2);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Principles ── */
  .principles-section {
    padding: 5rem 0;
    border-bottom: 1px solid var(--color-line-soft);
  }
  .principles-section .eyebrow { display: block; margin-bottom: 0.6rem; }
  .principles-section h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 2.5rem;
    line-height: 1.1;
  }
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .principle-item {
    display: flex;
    gap: 1.1rem;
    padding: 2rem;
    border-right: 1px solid rgba(241, 236, 224, 0.08);
    border-bottom: 1px solid rgba(241, 236, 224, 0.08);
    background: color-mix(in srgb, var(--color-surface) 40%, transparent);
    transition: background-color 0.3s ease, transform 0.3s ease;
  }
  .principle-item:hover { background-color: color-mix(in srgb, var(--color-surface) 80%, transparent); transform: translateY(-2px); }
  .principle-item:nth-child(3n) { border-right: 0; }
  .principle-item:nth-child(4),
  .principle-item:nth-child(5),
  .principle-item:nth-child(6) { border-bottom: 0; }
  .prin-num {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    flex: none;
    padding-top: 3px;
  }
  .prin-body h3 {
    font-size: 0.94rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }
  .prin-body p {
    font-size: 0.84rem;
    color: var(--color-text-2);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Team ── */
  .team-section {
    padding: 5rem 0;
    border-bottom: 1px solid var(--color-line-soft);
  }
  .team-section .eyebrow { display: block; margin-bottom: 0.6rem; }
  .team-section h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 2.5rem;
    line-height: 1.1;
  }
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }
  .team-member {
    background: color-mix(in srgb, var(--color-surface) 40%, transparent);
    border: 1px solid rgba(241, 236, 224, 0.08);
    border-radius: var(--radius-md);
    padding: 2rem;
  }
  .team-member h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.3rem;
  }
  .team-role {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 1rem;
  }
