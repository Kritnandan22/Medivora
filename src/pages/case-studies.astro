---
import ContentLayout from '~/layouts/ContentLayout.astro';

const cases = [
  {
    org: 'Global Top 10 Pharma',
    category: 'Intake',
    warn: false,
    title: 'Literature Intake at Scale',
    body: 'By deploying a fine-tuned LLM pipeline for literature screening, a top sponsor automated the extraction of valid ICSRs from thousands of weekly journal articles, reducing manual triage time by over 70% while maintaining 99% recall.',
    metric: '70% reduction in manual triage',
    slug: 'literature-intake',
  },
  {
    org: 'Mid-size CRO',
    category: 'Cautionary',
    warn: true,
    title: 'The hallucination risk in narratives',
    body: 'An off-the-shelf generative AI model was used to draft patient narratives from raw source documents. During QA, auditors found the model hallucinated a "resolved" outcome for a serious adverse event that was still ongoing. Zero-shot LLMs without strict grounding are dangerous in PV.',
    metric: 'Failed QA Audit due to hallucination',
    slug: 'hallucination-risk',
  },
  {
    org: 'Top 5 CRO',
    category: 'Coding',
    warn: false,
    title: 'Industrialised MedDRA Coding',
    body: 'Using semantic vector search and a custom AI agent, verbatim AE terms are now auto-coded to the MedDRA dictionary with high confidence. Human coders only handle the 15% of ambiguous cases that the agent flags for review.',
    metric: '85% auto-coding hit rate',
    slug: 'industrialised-coding',
  },
  {
    org: 'European Sponsor',
    category: 'Signal',
    warn: false,
    title: 'Expedited Reporting Compliance',
    body: 'An agentic workflow cross-references incoming serious adverse events against the core data sheet (CCDS) in real-time, instantly flagging unexpected events (SUSARs) to ensure strict adherence to 15-day expedited reporting rules.',
    metric: '100% 15-day compliance',
    slug: 'expedited-reporting',
  },
  {
    org: 'Enterprise Safety System',
    category: 'Safety',
    warn: false,
    title: 'Duplicate Detection Accuracy',
    body: 'Fuzzy logic and AI-driven matching algorithms compare incoming safety reports against millions of legacy cases in the central safety database, identifying duplicate reports with varying identifiers to prevent skewed signal detection.',
    metric: '94% duplicate detection accuracy',
    slug: 'duplicate-detection',
  },
  {
    org: 'Top 20 Pharma',
    category: 'Aggregate',
    warn: false,
    title: 'Automated PSUR / PBRER Drafting',
    body: 'A medical writing copilot aggregates thousands of line listings, synthesises the data, and drafts the initial framework for Periodic Safety Update Reports (PSURs). Medical writers now act as editors rather than authors.',
    metric: '60% faster aggregate reporting',
    slug: 'self-driving-psur',
  },
];
---

<ContentLayout
  title="Case Studies"
  description="Real deployments of automation in Pharmacovigilance — the wins and the honest limits. From ICSR intake to MedDRA coding."
  eyebrow="03 — In Practice"
  heading="Real PV deployments — <em>the wins and the honest limits.</em>"
  lede="The technology is past the demo stage in several PV areas. It has also produced cautionary tales worth keeping in view. Both matter."
>

  <section class="cases-section">
    <div class="wrap">
      
      <div class="hero-image-container">
        <video src="/videos/hero-dashboard.mp4" autoplay loop muted playsinline class="hero-image"></video>
      </div>

      <!-- Filter bar -->
      <div class="filter-bar" role="group" aria-label="Filter case studies">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="Intake">Intake</button>
        <button class="filter-btn" data-filter="Coding">Coding</button>
        <button class="filter-btn" data-filter="Safety">Safety</button>
        <button class="filter-btn" data-filter="Signal">Signal</button>
        <button class="filter-btn" data-filter="Aggregate">Aggregate</button>
        <button class="filter-btn" data-filter="Cautionary">Cautionary</button>
      </div>

      <div class="cases-grid" id="cases-grid">
        {cases.map((c) => (
          <a href={`/case-studies/${c.slug}`} class="case-card-link" style="text-decoration: none; color: inherit;">
            <article
              class={`case-card${c.warn ? ' case-warn' : ''}`}
              data-category={c.category}
            >
              <div class="case-org">
                <span class="case-org-name">{c.org}</span>
                <span class="case-pill">{c.category}</span>
              </div>
              <h2>{c.title}</h2>
              <p>{c.body}</p>
              <div class="case-metric">{c.metric}</div>
              <div class="read-more">Read full case study →</div>
            </article>
          </a>
        ))}
      </div>

      <aside class="disclaimer">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.5"/>
          <path d="M10 9v5M10 6.5v.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <p>Company examples, figures and outcomes are drawn from publicly reported industry sources
        and analyses. They are illustrative — not endorsements, guarantees, medical advice, or
        regulatory guidance. Verify any specific claim against primary sources.</p>
      </aside>

      <nav class="cases-nav">
        <a href="/value-chain" class="btn btn-ghost">← The value chain</a>
        <a href="/responsible-adoption" class="btn btn-primary">Doing it responsibly →</a>
      </nav>
    </div>
  </section>

</ContentLayout>

<style>
  .cases-section { padding: 3rem 0 5rem; }

  .hero-image-container {
    margin-bottom: 3rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .hero-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    max-height: 500px;
  }

  .cases-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .case-card {
    border: 1px solid rgba(241, 236, 224, 0.1);
    border-radius: var(--radius-lg);
    padding: 2.2rem 2rem;
    background: color-mix(in srgb, var(--color-surface) 60%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, border-color 0.4s ease;
    position: relative;
    overflow: hidden;
  }
  .case-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }
  .case-warn::before { background-color: var(--color-signal); }
  .case-card:hover { transform: translateY(-6px); box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4); border-color: rgba(241, 236, 224, 0.2); }
  .case-card:hover::before { transform: scaleX(1); }

  .case-warn {
    border-color: color-mix(in oklab, var(--color-signal) 30%, transparent);
  }

  .case-org {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }
  .case-org-name {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 500;
  }
  .case-warn .case-org-name { color: var(--color-signal); }

  .case-pill {
    font-size: 0.6rem;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    color: var(--color-text-soft);
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .case-card h2 {
    font-family: var(--font-serif);
    font-size: 1.28rem;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .case-card:hover h2 { color: #3b82f6; transition: color 0.3s ease; }
  .case-warn:hover h2 { color: var(--color-signal); }
  .case-card p {
    font-size: 0.93rem;
    color: var(--color-text-2);
    line-height: 1.55;
  }
  .case-metric {
    margin-top: 1rem;
    font-family: var(--font-serif);
    font-size: 1.04rem;
    color: var(--color-accent);
    font-weight: 600;
  }
  .case-warn .case-metric { color: var(--color-signal); }

  .read-more {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    font-weight: 600;
    transition: color 200ms ease;
  }
  .case-warn .read-more { color: var(--color-signal); }
  .case-card:hover .read-more { text-decoration: underline; }

  /* Filter bar */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.8rem;
  }
  .filter-btn {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    background-color: var(--color-surface);
    color: var(--color-text-soft);
    cursor: pointer;
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }
  .filter-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .filter-btn.active {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }

  /* Card visibility transitions */
  .case-card {
    transition: opacity 280ms ease, transform 280ms ease;
  }
  .case-card.filtered-out {
    opacity: 0;
    transform: scale(0.97);
    pointer-events: none;
    position: absolute;
    visibility: hidden;
  }

  /* Disclaimer */
  .disclaimer {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    background-color: var(--color-surface);
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-md);
    padding: 1.2rem 1.4rem;
    margin-bottom: 2.5rem;
  }
  .disclaimer svg { flex: none; margin-top: 2px; color: var(--color-text-soft); }
  .disclaimer p { font-size: 0.84rem; color: var(--color-text-soft); line-height: 1.55; }

  /* Nav */
  .cases-nav { display: flex; gap: 1rem; flex-wrap: wrap; }

  @media (max-width: 720px) {
    .cases-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  (function () {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('#cases-grid .case-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = (btn as HTMLElement).dataset.filter || 'all';

        // Update active button
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        // Show/hide cards
        cards.forEach((card) => {
          const cat = (card as HTMLElement).dataset.category || '';
          if (filter === 'all' || cat === filter) {
            card.classList.remove('filtered-out');
          } else {
            card.classList.add('filtered-out');
          }
        });
      });
    });
  })();
</script>
