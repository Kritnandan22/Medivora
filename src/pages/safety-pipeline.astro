---
import ContentLayout from '~/layouts/ContentLayout.astro';
import SafetyPipelineMap from '~/components/SafetyPipelineMap.astro';

const stages = [
  {
    num: '01',
    title: 'Phase 1 · Intake & Triage',
    slug: 'intake-triage',
    lead: 'The initial ingestion layer. Spontaneous reports arrive via unstructured emails, literature abstracts, patient portals, and call center transcripts.',
    wf: {
      label: 'Traditional Workflow',
      items: [
        'Automated ingestion of E2B(R3) payloads',
        'Deterministic routing of portal submissions',
        'Manual data entry for unstructured emails and PDFs',
      ],
    },
    ag: {
      label: 'Agentic Automation',
      items: [
        'Parsing unstructured patient emails and messy fax PDFs via OCR and semantic NLP',
        'Extracting the four required elements (patient, reporter, drug, event) autonomously',
        'Filtering out "junk" emails to prevent database pollution',
      ],
    },
    proof: 'The bottleneck: Manual intake accounts for up to 30% of PV operating costs. Agentic extraction converts unstructured mess into structured E2B fields instantly.',
  },
  {
    num: '02',
    title: 'Phase 2 · MedDRA Coding',
    slug: 'meddra-coding',
    lead: 'Translating verbatim descriptions into standardized medical ontologies (MedDRA Lowest Level Terms).',
    wf: {
      label: 'Traditional Workflow',
      items: [
        'Auto-coding exact character-for-character matches',
        'Applying static synonym lists',
        'Manual review for ambiguous terms',
      ],
    },
    ag: {
      label: 'Agentic Automation',
      items: [
        'Understanding clinical context to code ambiguous terms accurately',
        'Suggesting the top 3 most statistically probable MedDRA LLTs',
        'Handling misspellings and complex multi-concept medical phrases',
      ],
    },
    proof: 'The upgrade: Agentic coding systems are achieving >85% accuracy on first-pass coding, virtually eliminating the backlog for medical coders.',
  },
  {
    num: '03',
    title: 'Phase 3 · Medical Review',
    slug: 'medical-review',
    lead: 'The critical human checkpoint where causality is established (e.g., Naranjo scorecard) and narrative is finalized.',
    wf: {
      label: 'Traditional Workflow',
      items: [
        'Routing the completed case to the appropriate medical reviewer',
        'Manual drafting of medical narratives via string concatenation',
        'Collecting 21 CFR Part 11 compliant electronic signatures',
      ],
    },
    ag: {
      label: 'Agentic Automation',
      items: [
        'Pre-populating a causality scorecard based on de-challenge/re-challenge timelines',
        'Drafting fluid, grammatically correct medical narratives based on structured data',
        'Highlighting areas of low algorithmic confidence for the QPPV',
      ],
    },
    proof: 'The principle: Agentic systems in PV are "Human-in-the-Loop" by design. The AI does the heavy lifting; the QPPV makes the medical decision.',
  },
  {
    num: '04',
    title: 'Phase 4 · Aggregate Reporting',
    slug: 'aggregate-reporting',
    lead: 'Synthesis of millions of data points into periodic safety reports (PSUR, DSUR, PBRER).',
    wf: {
      label: 'Traditional Workflow',
      items: [
        'Exporting massive data line listings into Excel',
        'Manually drafting sections like "Patient Exposure" and "Line Listing Summary"',
      ],
    },
    ag: {
      label: 'Agentic Automation',
      items: [
        'Synthesizing massive line listings into coherent analytical prose',
        'Generating dynamic signals graphs and charts',
        'Drafting regulatory-ready PSUR/DSUR sections referencing prior intervals',
      ],
    },
    proof: 'The impact: Reducing a 6-week reporting cycle to a 2-week cycle, allowing teams to focus on true signal detection.',
  },
  {
    num: '05',
    title: 'Surveillance · Literature',
    slug: 'literature-monitoring',
    lead: 'Continuous tracking of scientific and medical literature for new safety signals associated with approved products.',
    wf: {
      label: 'Traditional Workflow',
      items: [
        'Manual boolean queries on PubMed/Embase',
        'Human triage of thousands of irrelevant abstracts',
      ],
    },
    ag: {
      label: 'Agentic Automation',
      items: [
        'Continuous screening of global medical literature',
        'Semantic filtering of non-relevant articles',
        'Extracting valid ICSRs directly from published case reports',
      ],
    },
    proof: 'The coverage: Agents monitor millions of abstracts 24/7 without fatigue, catching signals that boolean queries miss.',
  },
  {
    num: '06',
    title: 'Surveillance · RegIntel',
    slug: 'regulatory-intelligence',
    lead: 'Monitoring global health authority (FDA, EMA, PMDA) updates, guidance changes, and competitor labeling.',
    wf: {
      label: 'Traditional Workflow',
      items: [
        'Manually checking agency websites for new PDF guidances',
        'Reading 100-page documents to find a single relevant clause',
      ],
    },
    ag: {
      label: 'Agentic Automation',
      items: [
        'Monitoring global health authority (FDA, EMA, PMDA) updates via RSS and scraping',
        'Translating non-English regulatory updates into actionable summaries',
        'Cross-referencing new guidance against internal company SOPs to flag necessary updates',
      ],
    },
    proof: 'The compliance: Regulatory environments shift rapidly. Agentic intel ensures zero missed guidelines and proactive compliance.',
  },
];
---

<ContentLayout
  title="The Safety Pipeline"
  description="The Individual Case Safety Report (ICSR) lifecycle. Here is where deterministic workflow and agentic automation are applied to drug safety."
  eyebrow="02 — The Safety Pipeline"
  heading="The ICSR Lifecycle: <em>From intake to E2B submission.</em>"
  lede="From the moment an adverse event is reported to the final regulatory submission, here is how agentic AI handles the drug safety pipeline. Click any stage in the map to open it."
>

  <section class="vc-section">
    <div class="wrap">
      <SafetyPipelineMap />
    </div>
    <div class="wrap" style="margin-top:-2rem; margin-bottom:2rem;">
      <div class="reviewed-by-band" style="max-width:800px; margin:0 auto; background:var(--color-bg-alt); padding:0.75rem 1.25rem; border-radius:0.5rem; display:flex; align-items:center; gap:0.75rem; border:1px solid rgba(255,255,255,0.06);">
        <div class="rb-icon" style="color:var(--color-success);">✓</div>
        <div class="rb-text" style="font-size:0.8rem; color:var(--color-text-2);">
          Content reviewed by <strong>Kritnandan</strong>, B.Tech BSBE (IIT Kanpur) | Last review: Jun 2025
        </div>
      </div>
    </div>


    <!-- Cinematic Reviewer Image -->
    <div class="wrap">
      <div class="cinematic-image-wrapper">
        <img src="/images/pv_safety_reviewer.png" alt="A highly realistic photograph of a medical reviewer looking at a digital dashboard" class="cinematic-img">
      </div>
    </div>

    <div class="wrap">
      <div class="vc-accordion" id="vc-accordion">
        {stages.map((stage, i) => (
          <div class={`vc-item${i === 0 ? ' vc-open' : ''}`} id={`stage-${stage.slug}`}>
            <button
              class="vc-btn"
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${stage.slug}`}
            >
              <span class="vc-num">{stage.num}</span>
              <span class="vc-title">{stage.title}</span>
              <span class="vc-toggle" aria-hidden="true"></span>
            </button>
            <div
              class="vc-panel"
              id={`panel-${stage.slug}`}
              role="region"
              aria-labelledby={`btn-${stage.slug}`}
            >
              <div class="vc-inner">
                <p class="vc-lead">{stage.lead}</p>

                <div class="vc-block vc-wf">
                  <div class="vc-bt">
                    <span class="chip wf-chip">Deterministic</span>
                    <span class="vc-bt-label">{stage.wf.label}</span>
                  </div>
                  <ul>
                    {stage.wf.items.map(item => <li>{item}</li>)}
                  </ul>
                </div>

                <div class="vc-block vc-ag">
                  <div class="vc-bt">
                    <span class="chip ag-chip">Agentic</span>
                    <span class="vc-bt-label">{stage.ag.label}</span>
                  </div>
                  <ul>
                    {stage.ag.items.map(item => <li>{item}</li>)}
                  </ul>
                </div>

                <p class="vc-proof">{stage.proof}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom nav -->
  <section class="vc-footer-nav">
    <div class="wrap vc-footer-inner">
      <a href="/foundations" class="btn btn-ghost">← Foundations</a>
      <a href="/case-studies" class="btn btn-primary magnetic">See it in practice →</a>
    </div>
  </section>

</ContentLayout>

<style>
  .vc-section { padding: 2rem 0 5rem; }

  /* ── Cinematic Images ── */
  .cinematic-image-wrapper {
    margin: 1rem auto 3.5rem;
    max-width: 1000px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(241, 236, 224, 0.1);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.3);
  }
  .cinematic-img {
    width: 100%;
    height: auto;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    object-position: center 20%;
    display: block;
    transition: transform 0.8s ease;
  }
  .cinematic-image-wrapper:hover .cinematic-img {
    transform: scale(1.02);
  }

  /* Accordion container */
  .vc-accordion { border-top: 1px solid var(--color-line); }
  .vc-item { border-bottom: 1px solid var(--color-line); }

  /* Toggle button */
  .vc-btn {
    width: 100%;
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.9rem 0.4rem;
    font-family: inherit;
    transition: padding-left 200ms ease;
  }
  .vc-btn:hover { padding-left: 0.85rem; }

  .vc-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-signal);
    letter-spacing: 0.06em;
    min-width: 2rem;
  }
  .vc-title {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.4vw, 1.85rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.1;
    color: var(--color-text);
  }
  .vc-toggle {
    width: 34px;
    height: 34px;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    transition: background-color 240ms ease, border-color 240ms ease;
    position: relative;
  }
  .vc-toggle::before,
  .vc-toggle::after {
    content: '';
    position: absolute;
    background-color: var(--color-text);
    transition: transform 240ms ease, opacity 240ms ease;
  }
  .vc-toggle::before { width: 13px; height: 1.8px; }
  .vc-toggle::after  { width: 1.8px; height: 13px; }

  .vc-item.vc-open .vc-toggle {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .vc-item.vc-open .vc-toggle::before,
  .vc-item.vc-open .vc-toggle::after { background-color: white; }
  .vc-item.vc-open .vc-toggle::after { transform: scaleY(0); }

  /* Panel */
  .vc-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 460ms cubic-bezier(.4, 0, .2, 1);
  }
  .vc-inner {
    padding: 0.25rem 0.4rem 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.8rem;
  }
  .vc-lead {
    grid-column: 1 / -1;
    font-size: 1.06rem;
    color: var(--color-text-2);
    max-width: 62em;
    line-height: 1.6;
  }

  /* Content blocks */
  .vc-block {
    background-color: var(--color-surface);
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.4rem;
  }
  .vc-bt {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: var(--radius-xs);
  }
  .wf-chip { background-color: var(--color-accent); color: white; }
  .ag-chip { background-color: var(--color-signal); color: white; }
  .vc-bt-label { font-weight: 600; font-size: 0.96rem; color: var(--color-text); }

  .vc-block ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .vc-block li {
    font-size: 0.92rem;
    color: var(--color-text-2);
    line-height: 1.45;
    padding-left: 1.1rem;
    position: relative;
  }
  .vc-block li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }
  .vc-wf li::before { background-color: var(--color-accent); }
  .vc-ag li::before { background-color: var(--color-signal); }

  /* Proof quote */
  .vc-proof {
    grid-column: 1 / -1;
    font-size: 0.9rem;
    color: var(--color-text-soft);
    font-style: italic;
    border-left: 2px solid var(--color-signal);
    padding: 0.25rem 0 0.25rem 1rem;
    line-height: 1.55;
  }

  /* Footer nav */
  .vc-footer-nav { padding: 2rem 0 4.5rem; }
  .vc-footer-inner { display: flex; gap: 1rem; flex-wrap: wrap; }

  /* Responsive */
  @media (max-width: 700px) {
    .vc-inner { grid-template-columns: 1fr; }
    .vc-btn { gap: 1rem; }
  }
</style>

<script>
  (function () {
    const accordion = document.getElementById('vc-accordion');
    if (!accordion) return;

    // Open first panel on load
    const firstItem = accordion.querySelector('.vc-item.vc-open');
    if (firstItem) {
      const panel = firstItem.querySelector('.vc-panel') as HTMLElement | null;
      if (panel) panel.style.maxHeight = panel.scrollHeight + 'px';
    }

    // Toggle handler
    accordion.querySelectorAll('.vc-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.vc-item') as HTMLElement;
        const panel = item.querySelector('.vc-panel') as HTMLElement;
        const isOpen = item.classList.contains('vc-open');

        // Close all
        accordion.querySelectorAll('.vc-item').forEach((it) => {
          it.classList.remove('vc-open');
          const p = it.querySelector('.vc-panel') as HTMLElement;
          if (p) p.style.maxHeight = '';
          const b = it.querySelector('.vc-btn');
          if (b) b.setAttribute('aria-expanded', 'false');
        });

        // Open clicked (if it was closed)
        if (!isOpen) {
          item.classList.add('vc-open');
          panel.style.maxHeight = panel.scrollHeight + 'px';
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // Resize sync
    window.addEventListener('resize', () => {
      const open = accordion.querySelector('.vc-item.vc-open .vc-panel') as HTMLElement | null;
      if (open) open.style.maxHeight = open.scrollHeight + 'px';
    });
  })();
</script>
