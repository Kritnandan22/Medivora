---

<BaseLayout
  title="AI Agents Catalogue — Medivora"
  description="20 high-value AI agents for pharmaceutical development, pharmacovigilance, medical writing, literature review, and clinical research. Built for the life sciences industry."
>

<!-- ── HERO ─────────────────────────────────────────────── -->
<section class="agents-hero">
  <div class="wrap">
    <div class="hero-eyebrow">
      <span class="dot priority-dot"></span>
      <span>Medivora Agent Intelligence Platform</span>
    </div>
    <h1>20 AI Agents for<br/><em>Pharma & Medicine</em></h1>
    <p class="hero-lede">
      Each agent is purpose-built for a specific function in the pharmaceutical value chain —
      from regulatory intelligence to manufacturing quality. Not generic chatbots.
      Specialised, auditable, regulation-aware agents designed to work within GxP environments.
    </p>
    <div class="hero-stats">
      <div class="hs">
        <span class="hs-num">20</span>
        <span class="hs-label">Specialist Agents</span>
      </div>
      <div class="hs-div"></div>
      <div class="hs">
        <span class="hs-num">5</span>
        <span class="hs-label">Priority Phase 1</span>
      </div>
      <div class="hs-div"></div>
      <div class="hs">
        <span class="hs-num">8</span>
        <span class="hs-label">Pharma Domains</span>
      </div>
      <div class="hs-div"></div>
      <div class="hs">
        <span class="hs-num">60+</span>
        <span class="hs-label">Regulatory Standards</span>
      </div>
    </div>
  </div>
</section>

<!-- ── PRIORITY DOMAINS STRIP ─────────────────────────── -->
<section class="domains-strip">
  <div class="wrap">
    <p class="domains-label">Phase 1 Focus Areas</p>
    <div class="domains-row">
      {priorityDomains.map(d => (
        <div class="domain-chip" style={`--dc: ${d.color}`}>
          <span class="dc-dot"></span>
          <span class="dc-name">{d.label}</span>
          <span class="dc-count">{d.agents} agent{d.agents > 1 ? 's' : ''}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ── FILTER BAR ─────────────────────────────────────── -->
<section class="filter-bar-section">
  <div class="wrap">
    <div class="filter-bar" role="tablist">
      <button class="fb-btn active" data-filter="all" role="tab" aria-selected="true">
        All Agents <span class="fb-count">20</span>
      </button>
      <button class="fb-btn" data-filter="priority" role="tab" aria-selected="false">
        Phase 1 Priority <span class="fb-count priority">5</span>
      </button>
      <button class="fb-btn" data-filter="roadmap" role="tab" aria-selected="false">
        Development Roadmap <span class="fb-count">15</span>
      </button>
    </div>
  </div>
</section>

<!-- ── AGENT GRID ─────────────────────────────────────── -->
<section class="agents-grid-section">
