---
import BaseLayout from '~/layouts/BaseLayout.astro';

const priorityDomains = [
  { key: 'regulatory', label: 'Regulatory Affairs', color: '#1cc9a3', agents: 2 },
  { key: 'pharmacovigilance', label: 'Pharmacovigilance', color: '#e8a838', agents: 3 },
  { key: 'medical-writing', label: 'Medical Writing', color: '#6c8ef5', agents: 1 },
  { key: 'literature', label: 'Literature Review', color: '#e05c8a', agents: 2 },
  { key: 'clinical', label: 'Clinical Research', color: '#52c4a0', agents: 2 },
