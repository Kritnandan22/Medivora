---
import BaseLayout from '~/layouts/BaseLayout.astro';

const priorityDomains = [
  { key: 'pharmacovigilance', label: 'Pharmacovigilance', color: '#e8a838', agents: 6 }
];

const agents = [
  {
    id: 1,
    slug: 'intake-triage',
    name: 'Intake & Triage Agent',
    domain: 'Pharmacovigilance',
    domainKey: 'pharmacovigilance',
    phase: 'Phase 1 · Priority',
    priority: true,
    tagline: 'Automated extraction of valid ICSR elements from unstructured source documents.',
    description: 'Reads unstructured emails, abstracts, and faxes to extract Patient, Reporter, Suspect Drug, and Adverse Event. Validates E2B(R3) criteria and auto-creates the case in Argus or ArisG.',
    capabilities: [
      'Multi-modal intake (email, PDF, image OCR)',
      'Validity criteria assessment (4 minimum criteria)',
      'Automated E2B(R3) XML payload generation',
    ],
    valueMetric: '30%',
    valueLabel: 'reduction in manual case entry time',
    standards: ['ICH E2B(R3)', '21 CFR Part 11', 'EMA GVP Module VI'],
    dataConnections: ['Exchange/Outlook', 'Veeva Vault Safety', 'Oracle Argus'],
  },
  {
    id: 2,
    slug: 'meddra-coding',
    name: 'MedDRA Coding Agent',
    domain: 'Pharmacovigilance',
    domainKey: 'pharmacovigilance',
    phase: 'Phase 1 · Priority',
    priority: true,
    tagline: 'Semantic matching of verbatim clinical terms to MedDRA LLTs and WHO-DD.',
    description: 'Goes beyond exact dictionary string-matching. Uses semantic understanding of clinical context to suggest the most statistically probable MedDRA Lowest Level Terms (LLTs) for adverse events and indications.',
    capabilities: [
      'Context-aware semantic matching',
      'Confidence scoring and human-in-the-loop flagging',
      'Automated WHO-DD drug coding',
    ],
    valueMetric: '85%+',
    valueLabel: 'first-pass automated coding rate',
    standards: ['MedDRA 27.0+', 'WHO-DD'],
    dataConnections: ['MedDRA Browser API', 'Safety Database'],
  },
  {
    id: 3,
    slug: 'medical-review',
    name: 'Final Medical Review Copilot',
    domain: 'Pharmacovigilance',
    domainKey: 'pharmacovigilance',
    phase: 'Phase 1 · Priority',
    priority: true,
    tagline: 'AI reasoning assistant for the human QPPV or medical reviewer.',
    description: 'Acts as a copilot for the final human review step. Highlights areas of low confidence, provides reasoning traces for algorithmic decisions, and performs CIOMS consistency checks before ESG gateway submission.',
    capabilities: [
      'Reasoning traceability (explainable AI traces)',
      'Cross-field E2B consistency checking',
      'Automated query generation for missing information',
    ],
    valueMetric: '0',
    valueLabel: 'black-box decisions',
    standards: ['21 CFR Part 11', 'ICH E2D'],
    dataConnections: ['Safety Database', 'FDA ESG', 'EMA EudraVigilance'],
  },
  {
    id: 4,
    slug: 'aggregate-reporting',
    name: 'Aggregate Reporting Agent',
    domain: 'Pharmacovigilance',
    domainKey: 'pharmacovigilance',
    phase: 'Phase 1 · Priority',
    priority: true,
    tagline: 'Automated synthesis of line listings for PSURs, DSURs, and PBRERs.',
    description: 'Queries the safety database to compile complex line listings and automatically drafts the highly structured narrative summaries required for periodic safety update reports.',
    capabilities: [
      'Complex SQL/API querying of safety databases',
      'Generative drafting of PSUR/DSUR sections',
      'Signal detection denominator calculation',
    ],
    valueMetric: '40',
    valueLabel: 'hours saved per PSUR generation',
    standards: ['ICH E2C(R2)', 'GVP Module VII'],
    dataConnections: ['Argus Data Mart', 'Document Management System'],
  },
  {
    id: 5,
    slug: 'literature-monitoring',
    name: 'Literature Monitoring Agent',
    domain: 'Pharmacovigilance',
    domainKey: 'pharmacovigilance',
    phase: 'Phase 1 · Priority',
    priority: true,
    tagline: 'Continuous, autonomous surveillance of global scientific literature.',
    description: 'Scrapes PubMed, Embase, and local literature daily to identify potential adverse events associated with company products, filtering out false positives and translating abstracts autonomously.',
    capabilities: [
      'Autonomous daily scraping (PubMed, Embase, Ovid)',
      'Zero-shot classification for ICSR detection',
      'Automated translation of foreign-language abstracts',
    ],
    valueMetric: '95%',
    valueLabel: 'reduction in manual literature screening',
    standards: ['GVP Module VI', 'EMA MLM'],
    dataConnections: ['PubMed API', 'Ovid API', 'Embase'],
  },
  {
    id: 6,
    slug: 'regulatory-intelligence',
    name: 'Regulatory Intelligence Agent',
    domain: 'Pharmacovigilance',
    domainKey: 'pharmacovigilance',
    phase: 'Phase 1 · Priority',
    priority: true,
    tagline: 'Real-time monitoring of global health authority guidelines and mandates.',
    description: 'Continuously monitors global regulatory bodies (FDA, EMA, PMDA, MHRA) for updates to pharmacovigilance guidelines, automatically summarizing changes and assessing operational impact.',
    capabilities: [
      'Multi-lingual health authority scraping',
      'Regulatory impact assessment drafting',
      'Automated compliance alerts to QPPVs',
    ],
    valueMetric: '24/7',
    valueLabel: 'global regulatory surveillance',
    standards: ['FDA', 'EMA', 'PMDA', 'MHRA'],
    dataConnections: ['Global Health Authority RSS/HTML'],
  }
];

const priorityAgents = agents.filter(a => a.priority);
const roadmapAgents = agents.filter(a => !a.priority);

const domainColors: Record<string, string> = {
  'regulatory': '#1cc9a3',
  'pharmacovigilance': '#e8a838',
  'medical-writing': '#6c8ef5',
  'literature': '#e05c8a',
  'clinical': '#52c4a0',
  'quality': '#a78bfa',
  'medical-affairs': '#38bdf8',
  'manufacturing': '#fb923c',
  'commercial': '#f43f5e',
  'supply-chain': '#34d399',
  'clinical-decision': '#60a5fa',
};
---

<BaseLayout
  title="AI Agents Catalogue — Medivora"
  description="6 high-value AI agents for pharmacovigilance and drug safety. Built for the life sciences industry."
>

<!-- ── HERO ─────────────────────────────────────────────── -->
<section class="agents-hero">
  <div class="wrap">
    <div class="hero-eyebrow">
      <span class="dot priority-dot"></span>
      <span>Medivora Agent Intelligence Platform</span>
    </div>
    <h1>6 AI Agents for<br/><em>Pharmacovigilance</em></h1>
    <p class="hero-lede">
      Each agent is purpose-built for a specific function in the ICSR lifecycle —
      from unstructured intake to final medical review. Not generic chatbots.
      Specialised, auditable, regulation-aware agents designed to work within GxP environments.
    </p>
    <div class="hero-stats">
      <div class="hs">
        <span class="hs-num">6</span>
        <span class="hs-label">Specialist Agents</span>
      </div>
      <div class="hs-div"></div>
      <div class="hs">
        <span class="hs-num">6</span>
        <span class="hs-label">Priority Phase 1</span>
      </div>
      <div class="hs-div"></div>
      <div class="hs">
        <span class="hs-num">1</span>
        <span class="hs-label">Pharma Domain</span>
      </div>
      <div class="hs-div"></div>
      <div class="hs">
        <span class="hs-num">10+</span>
        <span class="hs-label">Regulatory Standards</span>
      </div>
    </div>
  </div>
</section>

<!-- ── PRIORITY DOMAINS STRIP ─────────────────────────── -->
<section class="domains-strip">
  <div class="wrap">
    <p class="domains-label">Phase 1 Focus Areas</p>
    <div class="domains-row">
      {priorityDomains.map(d => (
        <div class="domain-chip" style={`--dc: ${d.color}`}>
          <span class="dc-dot"></span>
          <span class="dc-name">{d.label}</span>
          <span class="dc-count">{d.agents} agent{d.agents > 1 ? 's' : ''}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ── FILTER BAR ─────────────────────────────────────── -->
<section class="filter-bar-section">
  <div class="wrap">
    <div class="filter-bar" role="tablist">
      <button class="fb-btn active" data-filter="all" role="tab" aria-selected="true">
        All Agents <span class="fb-count">6</span>
      </button>
      <button class="fb-btn" data-filter="priority" role="tab" aria-selected="false">
        Phase 1 Priority <span class="fb-count priority">6</span>
      </button>
    </div>
  </div>
</section>

<!-- ── AGENT GRID ─────────────────────────────────────── -->
<section class="agents-grid-section">
  <div class="wrap">

    <!-- Phase 1 heading -->
    <div class="grid-section-head phase1-head" data-section="priority">
      <div class="gsh-inner">
        <span class="phase-badge phase1-badge">Phase 1 · Active Development</span>
        <h2>Priority Focus Agents</h2>
        <p>These six agents represent the initial build priorities — areas with the highest regulatory burden, clearest ROI, and most mature AI tooling available today.</p>
      </div>
    </div>

    <div class="agents-grid" id="agents-grid">
      {agents.map(agent => (
        <article
          class={`agent-card ${agent.priority ? 'priority-card' : 'roadmap-card'}`}
          data-priority={agent.priority ? 'priority' : 'roadmap'}
          data-domain={agent.domainKey}
          style={`--acc: ${domainColors[agent.domainKey] || '#1cc9a3'}`}
        >

          <!-- Card header -->
          <div class="card-top">
            <div class="card-meta">
              <span class="domain-tag" style={`background: ${domainColors[agent.domainKey]}18; color: ${domainColors[agent.domainKey]}`}>
                {agent.domain}
              </span>
              <span class={`phase-tag ${agent.priority ? 'phase-p1' : 'phase-roadmap'}`}>
                {agent.phase}
              </span>
            </div>
            <div class="card-num">#{String(agent.id).padStart(2, '0')}</div>
          </div>

          <!-- Agent name -->
          <h3 class="card-name">{agent.name}</h3>
          <p class="card-tagline">{agent.tagline}</p>

          <!-- Description -->
          <p class="card-desc">{agent.description}</p>

          <!-- Capabilities -->
          <div class="card-caps">
            <p class="caps-label">Key Capabilities</p>
            <ul>
              {agent.capabilities.map(cap => (
                <li>
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M2 6l3 3 5-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {cap}
                </li>
              ))}
            </ul>
          </div>

          <!-- Value metric -->
          <div class="card-value">
            <span class="value-num">{agent.valueMetric}</span>
            <span class="value-lbl">{agent.valueLabel}</span>
          </div>

          <!-- Standards -->
          <div class="card-standards">
            {agent.standards.map(s => (
              <span class="std-chip">{s}</span>
            ))}
          </div>

          <!-- Data connections -->
          <div class="card-connections">
            <span class="conn-label">Data Sources</span>
            <div class="conn-list">
              {agent.dataConnections.map(c => (
                <span class="conn-item">{c}</span>
              ))}
            </div>
          </div>

          <!-- CTA -->
          <div class="card-footer">
            {agent.priority ? (
              <a href={`/agents/${agent.slug}`} class="card-cta primary-cta">
                Deep Dive
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            ) : (
              <span class="card-cta roadmap-cta">Coming Soon</span>
            )}
          </div>

        </article>
      ))}
    </div>

    <!-- Roadmap section removed -->

  </div>
</section>

<!-- ── COMPARISON TABLE ───────────────────────────────── -->
<section class="comparison-section">
  <div class="wrap" style="overflow-x: auto;">
    <div class="grid-section-head">
      <h2>Agents Comparison</h2>
      <p>A high-level technical breakdown of the 6 core pharmacovigilance agents.</p>
    </div>
    <table class="comparison-table">
      <thead>
        <tr>
          <th>Agent</th>
          <th>Phase</th>
          <th>Inputs</th>
          <th>Outputs</th>
          <th>Standards</th>
          <th>Model Class</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong><a href="/agents/intake-triage">Intake & Triage</a></strong></td>
          <td>Phase 1</td>
          <td>Emails, PDFs, Faxes</td>
          <td>E2B JSON payload</td>
          <td>ICH E2B(R3)</td>
          <td>Multi-modal Vision / LLM</td>
        </tr>
        <tr>
          <td><strong><a href="/agents/meddra-coding">MedDRA Coding</a></strong></td>
          <td>Phase 2</td>
          <td>Verbatim terms, Narratives</td>
          <td>MedDRA LLT + Confidence</td>
          <td>MedDRA 27.x</td>
          <td>Embeddings / RAG + LLM</td>
        </tr>
        <tr>
          <td><strong><a href="/agents/medical-review">Medical Review</a></strong></td>
          <td>Phase 3</td>
          <td>Draft ICSR, Patient Hx</td>
          <td>Naranjo Score, Narrative</td>
          <td>21 CFR Part 11</td>
          <td>Reasoning LLM</td>
        </tr>
        <tr>
          <td><strong><a href="/agents/aggregate-reporting">Aggregate Reporting</a></strong></td>
          <td>Phase 4</td>
          <td>Line Listings, Queries</td>
          <td>Draft PSUR Sections</td>
          <td>ICH E2C(R2)</td>
          <td>Map-Reduce / Long Context</td>
        </tr>
        <tr>
          <td><strong><a href="/agents/literature-monitoring">Literature Monitoring</a></strong></td>
          <td>Surveillance</td>
          <td>PubMed/Embase Abstracts</td>
          <td>Triage classification, E2B</td>
          <td>EMA MLM</td>
          <td>Zero-shot Classifier</td>
        </tr>
        <tr>
          <td><strong><a href="/agents/regulatory-intelligence">Regulatory Intel</a></strong></td>
          <td>Surveillance</td>
          <td>Health Authority Websites</td>
          <td>Regulatory Impact Alerts</td>
          <td>FDA, EMA, PMDA</td>
          <td>Web Scraper + RAG</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<!-- ── REQUEST ACCESS CTA ─────────────────────────────── -->
<section class="access-section">
  <div class="wrap">
    <div class="access-inner">
      <div class="access-text">
        <span class="eyebrow">Early Access Programme</span>
        <h2>Get notified when each agent goes live</h2>
        <p>We're building Phase 1 Pharmacovigilance agents now. Join the list to receive deep-dive content, architecture walkthroughs, and implementation guides as each agent is published.</p>
      </div>
      <a href="/contact" class="access-btn">Request Early Access →</a>
    </div>
  </div>
</section>

</BaseLayout>

<script>
  // ── Filter logic ──────────────────────────────────────────────────────────
  const buttons = document.querySelectorAll<HTMLButtonElement>('.fb-btn');
  const cards   = document.querySelectorAll<HTMLElement>('.agent-card');
  const roadmapSep = document.getElementById('roadmap-sep');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter as string;

      buttons.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      cards.forEach(card => {
        const isPriority = card.dataset.priority === 'priority';
        if (filter === 'all') {
          card.style.display = '';
        } else if (filter === 'priority') {
          card.style.display = isPriority ? '' : 'none';
        } else {
          card.style.display = !isPriority ? '' : 'none';
        }
      });

      // Show/hide roadmap separator
      if (roadmapSep) {
        roadmapSep.style.display = filter === 'priority' ? 'none' : '';
      }
    });
  });
</script>

<style>
  /* ── Hero ──────────────────────────────────────────── */
  .agents-hero {
    background: #060e0b;
    padding: 5.5rem 0 4rem;
    border-bottom: 1px solid rgba(28,201,163,.12);
  }
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #1cc9a3;
    margin-bottom: 1.6rem;
  }
  .dot { width: 7px; height: 7px; border-radius: 50%; flex: none; }
  .priority-dot { background: #1cc9a3; box-shadow: 0 0 6px #1cc9a3; animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }

  .agents-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 700;
    color: #f1ece0;
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 0 0 1.4rem;
  }
  .agents-hero h1 em { color: #1cc9a3; font-style: italic; }
  .hero-lede {
    font-size: 1.05rem;
    color: rgba(241,236,224,.62);
    line-height: 1.7;
    max-width: 52em;
    margin-bottom: 3rem;
  }
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 0;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .hs {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1.2rem 2rem;
    background: rgba(241,236,224,.04);
    border: 1px solid rgba(241,236,224,.08);
    border-radius: var(--radius-md);
  }
  .hs-num {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
    color: #1cc9a3;
    line-height: 1;
  }
  .hs-label {
    font-size: 0.75rem;
    color: rgba(241,236,224,.5);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .hs-div { display: none; }

  /* ── Domain strip ─────────────────────────────────── */
  .domains-strip {
    background: #060e0b;
    padding: 0 0 3rem;
    border-bottom: 1px solid rgba(28,201,163,.1);
  }
  .domains-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(241,236,224,.4);
    margin-bottom: 1rem;
  }
  .domains-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .domain-chip {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 1rem;
    background: rgba(28,201,163,.06);
    border: 1px solid color-mix(in srgb, var(--dc) 25%, transparent);
    border-radius: 100px;
  }
  .dc-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--dc);
    flex: none;
  }
  .dc-name {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--dc);
  }
  .dc-count {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: rgba(241,236,224,.45);
    letter-spacing: 0.06em;
  }

  /* ── Filter bar ───────────────────────────────────── */
  .filter-bar-section {
    padding: 1.8rem 0;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-bg);
    position: sticky;
    top: 66px;
    z-index: 10;
  }
  .filter-bar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .fb-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--color-line);
    border-radius: 100px;
    background: transparent;
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--color-text-2);
    cursor: pointer;
    transition: all 180ms ease;
  }
  .fb-btn:hover { border-color: #1cc9a3; color: var(--color-text); }
  .fb-btn.active {
    background: #1cc9a3;
    border-color: #1cc9a3;
    color: #060e0b;
    font-weight: 700;
  }
  .fb-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    background: rgba(241,236,224,.12);
    border-radius: 100px;
    padding: 1px 6px;
  }
  .fb-btn.active .fb-count { background: rgba(6,14,11,.2); }
  .fb-count.priority { background: rgba(28,201,163,.15); color: #1cc9a3; }

  /* ── Grid ─────────────────────────────────────────── */
  .agents-grid-section { padding: 3rem 0 5rem; background: var(--color-bg); }

  .grid-section-head, .grid-section-sep {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-line-soft);
  }
  .grid-section-sep {
    margin-top: 4rem;
    padding-top: 0;
    border-bottom: none;
    border-top: 1px solid var(--color-line-soft);
    padding-top: 3rem;
  }
  .gsh-inner { max-width: 52em; }
  .phase-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 100px;
    margin-bottom: 0.9rem;
  }
  .phase1-badge { background: rgba(28,201,163,.12); color: #1cc9a3; border: 1px solid rgba(28,201,163,.25); }
  .roadmap-badge { background: rgba(241,236,224,.06); color: var(--color-text-soft); border: 1px solid var(--color-line-soft); }
  .grid-section-head h2, .grid-section-sep h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0.3rem 0 0.7rem;
  }
  .grid-section-head p, .grid-section-sep p {
    font-size: 0.95rem;
    color: var(--color-text-2);
    line-height: 1.65;
  }

  .agents-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }

  /* ── Agent card ───────────────────────────────────── */
  .agent-card {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    padding: 1.6rem;
    position: relative;
    overflow: hidden;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }
  .agent-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--acc);
    opacity: 0;
    transition: opacity 180ms ease;
  }
  .agent-card:hover { transform: translateY(-3px); box-shadow: 0 8px 32px rgba(0,0,0,.12); border-color: color-mix(in srgb, var(--acc) 30%, var(--color-line)); }
  .agent-card:hover::before { opacity: 1; }
  .priority-card { border-color: color-mix(in srgb, var(--acc) 20%, var(--color-line)); }
  .priority-card::before { opacity: 0.6; }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }
  .card-meta { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .domain-tag {
