<script>
  // ── Filter logic ──────────────────────────────────────────────────────────
  const buttons = document.querySelectorAll<HTMLButtonElement>('.fb-btn');
  const cards   = document.querySelectorAll<HTMLElement>('.agent-card');
  const roadmapSep = document.getElementById('roadmap-sep');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter as string;

      buttons.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      cards.forEach(card => {
        const isPriority = card.dataset.priority === 'priority';
        if (filter === 'all') {
          card.style.display = '';
        } else if (filter === 'priority') {
          card.style.display = isPriority ? '' : 'none';
        } else {
          card.style.display = !isPriority ? '' : 'none';
        }
      });

      // Show/hide roadmap separator
      if (roadmapSep) {
        roadmapSep.style.display = filter === 'priority' ? 'none' : '';
      }
    });
  });
</script>

