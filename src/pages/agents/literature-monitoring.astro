            <div class="demo-panel-body"><pre style="white-space:pre-wrap; margin:0; font-size:0.8rem; color:#a8b2d1;">Abstract: 'A 52-year-old male developed Stevens-Johnson syndrome 10 days after starting Drug-Z for epilepsy. The drug was discontinued and the patient was treated with IV immunoglobulin...'</pre></div>
          </div>
          <div class="demo-panel">
            <div class="demo-panel-header">Agent Output</div>
            <div class="demo-panel-body"><pre style="white-space:pre-wrap; margin:0; font-size:0.8rem; color:#a8b2d1;">{\n  "is_valid_icsr": true,\n  "classification": "Individual case report",\n  "patient": { "age": 52, "sex": "M" },\n  "drug": "Drug-Z",\n  "indication": "Epilepsy",\n  "event": "Stevens-Johnson syndrome",\n  "onset_days": 10,\n  "action": "Drug withdrawn",\n  "treatment": "IV immunoglobulin"\n}</pre></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── RISK & COMPLIANCE ────────────────────────────────── -->
