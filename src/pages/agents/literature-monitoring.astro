      <div class="wrap">
        <span class="eyebrow">Risk & Compliance</span>
        <h2>Failure Modes, Validation & Integration</h2>
        
        <h3>Risk & Failure Mode Matrix</h3>
        <table class="risk-matrix">
          <thead><tr>
            <th>Failure Mode</th><th>Severity</th><th>Likelihood</th><th>Mitigation</th><th>Residual Risk</th>
          </tr></thead>
          <tbody>
            <tr><td>False positive (study misclassified as ICSR)</td><td class="risk-med">Medium</td><td class="risk-high">High</td><td>Multi-stage classification pipeline</td><td class="risk-med">Medium</td></tr>
            <tr><td>Paywall blocking full text access</td><td class="risk-low">Low</td><td class="risk-high">High</td><td>Flag as 'Full Text Required' for human procurement</td><td class="risk-low">Low</td></tr>
            <tr><td>Missed foreign language article</td><td class="risk-high">High</td><td class="risk-med">Medium</td><td>Multi-lingual LLM + translation pipeline</td><td class="risk-low">Low</td></tr>
            <tr><td>Predatory journal citation</td><td class="risk-low">Low</td><td class="risk-med">Medium</td><td>Journal quality scoring + whitelist</td><td class="risk-low">Negligible</td></tr>
          </tbody></table>
        
        <h3>Validation & Qualification</h3>
        <p style="font-size:0.9rem; color:rgba(241,236,224,0.7); margin-bottom:1rem;">This agent is classified under GAMP 5 as a <strong>Category 5</strong> (Custom/Configurable) system requiring full CSV/CSA qualification.</p>
        <div style="display:flex; gap:1rem; flex-wrap:wrap;">
          <span class="gamp-badge">GAMP 5 — Category 5</span>
          <span class="gamp-badge">21 CFR Part 11 Compliant</span>
          <span class="gamp-badge">EU Annex 11 Ready</span>
        </div>
        
        <h3>Integration Points</h3>
        <div class="integration-grid">
          <div class="integration-chip"><div><div>PubMed E-utilities</div><div class="ic-type">API</div></div></div>
          <div class="integration-chip"><div><div>Embase / Ovid</div><div class="ic-type">API</div></div></div>
          <div class="integration-chip"><div><div>Safety Database</div><div class="ic-type">Output</div></div></div>
          <div class="integration-chip"><div><div>CRON Scheduler</div><div class="ic-type">Orchestration</div></div></div>
        </div>
        
