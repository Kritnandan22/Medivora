---
import BaseLayout from '~/layouts/BaseLayout.astro';

const domainColor = '#8b5cf6'; // Purple for Literature
---

<BaseLayout
  title="Literature Monitoring Agent — Medivora"
  description="Architecture and capabilities of the Medivora Literature Monitoring Agent for global medical literature screening."
>
  <article class="agent-detail-page">
    
    <!-- ── HERO ─────────────────────────────────────────────── -->
    <header class="agent-hero">
      <div class="wrap">
        <div class="breadcrumb">
          <a href="/agents">← Back to Agents</a>
        </div>
        
        <div class="hero-meta">
          <span class="domain-tag" style={`--dc: ${domainColor}`}>Pharmacovigilance</span>
          <span class="phase-tag">Phase 1 · Signal & Intake</span>
          <span class="date-tag">Last reviewed: Nov 2024</span>
        </div>
        
        <h1 class="agent-title">Literature Monitoring Agent</h1>
        <p class="agent-tagline">Continuous, autonomous surveillance of global scientific literature.</p>

        <div class="cinematic-image-wrapper">
          <img src="/images/pv_agent_literature.png" alt="Realistic photograph of a digital library of scientific journals" class="cinematic-img">
        </div>
        
        <div class="agent-metrics">
          <div class="metric-box">
            <span class="mb-val">100k+</span>
            <span class="mb-lbl">Abstracts screened per day</span>
          </div>
          <div class="metric-box">
            <span class="mb-val">99.5%</span>
            <span class="mb-lbl">Sensitivity for valid ICSRs</span>
          </div>
          <div class="metric-box">
            <span class="mb-val">60%</span>
            <span class="mb-lbl">Reduction in false-positive manual reviews</span>
          </div>
        </div>
        <p class="metrics-disclaimer" style="font-size:0.75rem; color:rgba(241,236,224,.5); margin-top:1rem; font-style:italic;">* Target metrics and early observations from industry pilots.</p>
      </div>
    </header>

    <!-- ── THE PROBLEM ──────────────────────────────────────── -->
    <section class="section-light problem-section">
      <div class="wrap content-grid">
        <div class="cg-main">
          <h2>The Noise of Global Literature</h2>
          <p class="lead-text">
            Sponsors are required to monitor global scientific literature (PubMed, Embase, local journals) for adverse events related to their products. This involves highly trained scientists manually reading thousands of abstracts per week, the vast majority of which do not contain valid ICSRs.
          </p>
          <p>
            The Medivora Literature Monitoring Agent automates the first pass. It connects directly to literature databases, reads the title and abstract, and uses semantic reasoning to determine if the article mentions a suspect drug, an adverse event, and a specific patient case, filtering out background noise, in-vitro studies, and general reviews.
          </p>
        </div>
        <aside class="cg-side info-panel">
          <h4>Agent Profile</h4>
          <dl class="agent-specs">
            <dt>Data Inputs</dt>
            <dd>PubMed, Embase, Ovid, local non-English journals.</dd>
            <dt>Core AI Models</dt>
            <dd>Biomedical-specific LLMs (e.g., BioGPT, Med-PaLM) optimized for scientific text.</dd>
            <dt>Key Outputs</dt>
            <dd>Screened abstracts categorized as 'ICSR', 'Signal', 'Special Situation', or 'Irrelevant'.</dd>
            <dt>Standards</dt>
            <dd>GVP Module VI, EMA MLM requirements.</dd>
          </dl>
        </aside>
      </div>
    </section>

    <!-- ── ARCHITECTURE ─────────────────────────────────────── -->
    <section class="section-dark arch-section">
      <div class="wrap">
        <h2>Agent Architecture &amp; Workflow</h2>
        <p class="section-desc">
          The agent utilizes a multi-step triage process. It first excludes obvious non-clinical papers, then searches for suspect drugs, and finally evaluates the text against strict ICSR validity criteria.
        </p>
        
        <div class="diagram-container">
          <pre class="mermaid">
flowchart LR
    classDef external fill:#1a1a1a,stroke:#333,stroke-width:1px,color:#888
    classDef input fill:#112a22,stroke:#8b5cf6,stroke-width:1px,color:#fff
    classDef agent fill:#0a192f,stroke:#64ffda,stroke-width:1px,color:#fff
    classDef db fill:#2d1b2e,stroke:#e05c8a,stroke-width:1px,color:#fff
    classDef hitl fill:#3a2a00,stroke:#e8a838,stroke-width:1px,color:#fff
    classDef output fill:#112a22,stroke:#8b5cf6,stroke-width:2px,color:#fff

    subgraph "Data Sources"
        PubMed["PubMed / Embase APIs"]:::external
    end

    subgraph "Filtering & Triage"
        direction TB
        Ingest["Query Execution Agent"]:::input
        Triage(["Relevance Assessment<br>(LLM)"]):::agent
        ValidDB[("Product List /<br>Synonyms")]:::db
    end

    subgraph "Action Layer"
        direction TB
        Irrelevant["Irrelevant<br>(Auto-Discard)"]:::output
        Review["Potential ICSR<br>Human Review Queue"]:::hitl
        FullText["Fetch Full Text<br>for further analysis"]:::agent
    end

    PubMed --> Ingest
    Ingest --> Triage
    ValidDB --> Triage

    Triage -- "No suspect drug /<br>In-vitro study" --> Irrelevant
    Triage -- "Valid case criteria met" --> FullText
    FullText --> Review

    linkStyle default stroke:#444,stroke-width:2px;
          </pre>
        </div>
      </div>
    </section>

    <!-- ── CORE CAPABILITIES ────────────────────────────────── -->
    <section class="section-light caps-section">
      <div class="wrap">
        <h2 class="section-title-dark">Core Capabilities</h2>
        <div class="caps-grid">
          <div class="cap-card">
            <div class="cap-icon">1</div>
            <h3>Intelligent Exclusion</h3>
            <p>Accurately filters out animal studies, in-vitro experiments, epidemiological reviews, and general disease overviews, drastically reducing the volume of abstracts requiring human review.</p>
          </div>
          <div class="cap-card">
            <div class="cap-icon">2</div>
            <h3>Special Situation Flagging</h3>
            <p>Automatically detects and tags special situations such as pregnancy exposure, overdose, off-label use, or lack of efficacy, even if no adverse event is explicitly mentioned.</p>
          </div>
          <div class="cap-card">
            <div class="cap-icon">3</div>
            <h3>Automated Full-Text Retrieval</h3>
            <p>When an abstract is flagged as a potential ICSR, the agent can automatically interface with library subscriptions to retrieve the full-text PDF for the safety reviewer.</p>
          </div>
          <div class="cap-card">
            <div class="cap-icon">4</div>
            <h3>Audit-Ready Justifications</h3>
            <p>For every abstract rejected, the agent generates a one-sentence GVP-compliant justification (e.g., "Excluded: In-vitro study on murine models, no human safety data").</p>
          </div>
        </div>
      </div>
    </section>

  
    <!-- ── UNDER THE HOOD ───────────────────────────────────── -->
    <section class="section-dark under-hood-section">
      <div class="wrap">
        <span class="eyebrow">Under the Hood</span>
        <h2>Architectural Deep Dive</h2>
        
        <div class="uh-grid">
          <div class="uh-col">
            <h3>API Integration & Tool Calling</h3>
            <p>The agent runs on a scheduled CRON job, automatically querying PubMed, Embase, and other literature databases using complex boolean search strings, fetching XML abstracts for evaluation.</p>
            <div class="code-block-wrapper">
              <div class="code-header"><span class="code-dot r"></span><span class="code-dot y"></span><span class="code-dot g"></span><span class="code-title">scheduled_task.py</span></div>
              <pre is:raw><code>def daily_literature_scan(drug_name):
    # Agent calls PubMed E-utilities API
    tool_call = {
        "action": "query_pubmed",
        "query": f'({drug_name}[Title/Abstract]) AND (adverse[Title/Abstract] OR toxicity[Title/Abstract])',
        "date_range": "last_24_hours"
    }
    
    abstracts = execute_tool(tool_call)
    
    # Pass to LLM for zero-shot triage
    return [evaluate_abstract(a) for a in abstracts]</code></pre>
            </div>
          </div>
          
          <div class="uh-col">
            <h3>Zero-Shot ICSR Triage</h3>
            <p>The agent reads the abstract and determines if it represents a valid ICSR (containing a specific patient and adverse event), or if it is just a general study, animal study, or review article.</p>
            <div class="code-block-wrapper">
              <div class="code-header"><span class="code-dot r"></span><span class="code-dot y"></span><span class="code-dot g"></span><span class="code-title">system_prompt.txt</span></div>
              <pre is:raw><code>Evaluate the following scientific abstract.

TASK:
Determine if this abstract contains a valid Individual Case Safety Report (ICSR).

EXCLUSION CRITERIA (Mark as INVALID if):
- It is an animal / in-vitro study.
- It is a broad epidemiological study without individual patient timelines.
- It is a review article summarizing past literature.

If VALID, extract:
- Patient demographics
- Adverse event(s)
- Suspect drug(s)

Output in strict JSON format.</code></pre>
            </div>
          </div>
        </div>

        <div class="guardrails-box">
          <h3>Guardrails & Failure Modes</h3>
          <ul class="guardrail-list">
            <li><strong>False Positives:</strong> The agent may flag an epidemiological study that mentions "30 patients had a rash" as 30 individual ICSRs. Prompts must be highly tuned to differentiate between aggregate study results and individual case reports.</li>
            <li><strong>Paywalls:</strong> The agent can only read the abstract if the full text is behind a paywall. If the abstract hints at a case report but lacks details, the agent is programmed to flag it as "Full Text Required" and queue it for human procurement.</li>
            <li><strong>Author Affiliation Bias:</strong> The agent must identify if the author is affiliated with a competitor company or if the literature originates from a known predatory journal, weighting the signal accordingly.</li>
          </ul>
        </div>

      </div>
    </section>

  </article>
</BaseLayout>

<script is:inline type="module">
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
  mermaid.initialize({
    startOnLoad: true,
    theme: 'base',
    themeVariables: {
      primaryColor: '#8b5cf6',
      primaryTextColor: '#fff',
      primaryBorderColor: '#333',
      lineColor: '#666',
      secondaryColor: '#0a192f',
      tertiaryColor: '#111'
    },
    fontFamily: 'Inter, sans-serif'
  });
</script>

<style>
  .mermaid { visibility: hidden; }
  .mermaid[data-processed="true"] { visibility: visible; }
  .date-tag { font-family: var(--font-mono); font-size: 0.65rem; color: rgba(241,236,224,.5); border: 1px dashed rgba(241,236,224,.2); padding: 4px 10px; border-radius: 100px; }
  /* Reuse standard agent layout styles */
  .agent-detail-page { background: var(--color-bg); min-height: 100vh; }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 5%; }
  .section-light { padding: 5rem 0; background: var(--color-bg); border-bottom: 1px solid var(--color-line); }
  .section-dark { padding: 6rem 0; background: #060e0b; color: #f1ece0; border-bottom: 1px solid rgba(139,92,246,.15); }
  
  .content-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 4rem; }
  @media (max-width: 900px) { .content-grid { grid-template-columns: 1fr; gap: 3rem; } }

  .agent-hero { background: #060e0b; padding: 3rem 0 5rem; border-bottom: 1px solid rgba(139,92,246,.15); color: #f1ece0; }
  .breadcrumb { margin-bottom: 3rem; }
  .breadcrumb a { font-size: 0.85rem; color: rgba(241,236,224,.5); text-decoration: none; transition: color 200ms ease; }
  .breadcrumb a:hover { color: #8b5cf6; }

  .hero-meta { display: flex; gap: 0.8rem; margin-bottom: 1.5rem; align-items: center; }
  .domain-tag { font-size: 0.75rem; font-weight: 600; color: var(--dc); background: color-mix(in srgb, var(--dc) 15%, transparent); padding: 4px 10px; border-radius: 100px; }
  .phase-tag { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.05em; color: rgba(241,236,224,.6); border: 1px solid rgba(241,236,224,.2); padding: 4px 10px; border-radius: 100px; }

  .agent-title { font-family: var(--font-serif); font-size: clamp(2.5rem, 4vw, 3.5rem); font-weight: 700; line-height: 1.1; margin-bottom: 1rem; letter-spacing: -0.02em; }
  .agent-tagline { font-size: 1.2rem; color: rgba(241,236,224,.7); max-width: 45em; line-height: 1.5; margin-bottom: 2rem; }

  /* ── Cinematic Images ── */
  .cinematic-image-wrapper {
    margin: 0 auto 3rem;
    max-width: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(241, 236, 224, 0.1);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }
  .cinematic-img {
    width: 100%;
    height: auto;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    object-position: center 50%;
    display: block;
    transition: transform 0.8s ease;
  }
  .cinematic-image-wrapper:hover .cinematic-img {
    transform: scale(1.02);
  }

  .agent-metrics { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .metric-box { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); padding: 1.5rem; border-radius: 8px; min-width: 220px; }
  .mb-val { display: block; font-family: var(--font-mono); font-size: 2rem; font-weight: 700; color: #8b5cf6; line-height: 1; margin-bottom: 0.5rem; }
  .mb-lbl { display: block; font-size: 0.85rem; color: rgba(241,236,224,.6); line-height: 1.4; }

  .problem-section h2 { font-family: var(--font-serif); font-size: 2rem; margin-bottom: 1.5rem; color: var(--color-text); }
  .lead-text { font-size: 1.15rem; line-height: 1.7; color: var(--color-text); font-weight: 500; margin-bottom: 1.5rem; }
  .cg-main p { font-size: 1.05rem; line-height: 1.7; color: var(--color-text-2); margin-bottom: 1.5rem; }

  .info-panel { background: var(--color-surface); border: 1px solid var(--color-line); padding: 2rem; border-radius: 8px; height: fit-content; }
  .info-panel h4 { font-family: var(--font-mono); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text); margin-bottom: 1.5rem; border-bottom: 1px solid var(--color-line); padding-bottom: 0.5rem; }
  .agent-specs dt { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #8b5cf6; margin-top: 1.2rem; margin-bottom: 0.3rem; }
  .agent-specs dt:first-child { margin-top: 0; }
  .agent-specs dd { margin: 0; font-size: 0.9rem; color: var(--color-text-2); line-height: 1.5; }

  .arch-section h2 { font-family: var(--font-serif); font-size: 2.2rem; margin-bottom: 1rem; }
  .section-desc { font-size: 1.1rem; color: rgba(241,236,224,.7); max-width: 50em; line-height: 1.6; margin-bottom: 3rem; }
  .diagram-container { background: #0d1a15; border: 1px solid rgba(139,92,246,.2); border-radius: 12px; padding: 2rem; overflow-x: auto; }

  :global(.mermaid .edgePath path) { stroke-dasharray: 8 4; animation: flowLines 1.5s linear infinite; }
  @keyframes flowLines { to { stroke-dashoffset: -12; } }
  :global(.mermaid .node) { transition: transform 0.3s ease, filter 0.3s ease; cursor: pointer; }
  :global(.mermaid .node:hover) { transform: scale(1.03); filter: drop-shadow(0 0 12px rgba(139,92,246,0.4)); }

  .caps-section { background: var(--color-surface); }
  .section-title-dark { font-family: var(--font-serif); font-size: 2.2rem; margin-bottom: 2rem; color: var(--color-text); }
  .caps-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  @media (max-width: 768px) { .caps-grid { grid-template-columns: 1fr; } }
  .cap-card { background: var(--color-bg); border: 1px solid var(--color-line); padding: 2rem; border-radius: 8px; transition: transform 200ms ease; }
  .cap-card:hover { transform: translateY(-3px); border-color: #8b5cf6; }
  .cap-icon { width: 40px; height: 40px; background: rgba(139,92,246,.1); color: #8b5cf6; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-weight: bold; font-size: 1.2rem; margin-bottom: 1.2rem; }
  .cap-card h3 { font-size: 1.2rem; margin-bottom: 0.8rem; color: var(--color-text); }
  .cap-card p { font-size: 0.95rem; color: var(--color-text-2); line-height: 1.6; }
</style>
