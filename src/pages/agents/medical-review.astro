            </div>
          </a>
        </nav>
      </div>
    </section>

  </article>

<script is:inline>
  // Copy-to-clipboard for code blocks
  document.querySelectorAll('.code-block-wrapper').forEach(wrapper => {
    wrapper.style.position = 'relative';
    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.textContent = 'Copy';
    btn.addEventListener('click', () => {
      const code = wrapper.querySelector('code');
      if (code) {
        navigator.clipboard.writeText(code.textContent).then(() => {
          btn.textContent = 'Copied!';
          btn.classList.add('copied');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2000);
        });
      }
    });
    wrapper.appendChild(btn);
  });
  // Feedback buttons
  document.querySelectorAll('.feedback-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.feedback-btn').forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
    });
  });
</script>
</BaseLayout>

<script is:inline type="module">
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
  mermaid.initialize({
    startOnLoad: true,
    theme: 'base',
    themeVariables: {
      primaryColor: '#f59e0b',
      primaryTextColor: '#fff',
      primaryBorderColor: '#333',
      lineColor: '#666',
      secondaryColor: '#0a192f',
      tertiaryColor: '#111'
    },
    fontFamily: 'Inter, sans-serif'
  });
</script>

<style>
  .mermaid { visibility: hidden; }
  .mermaid[data-processed="true"] { visibility: visible; }
  .date-tag { font-family: var(--font-mono); font-size: 0.65rem; color: rgba(241,236,224,.5); border: 1px dashed rgba(241,236,224,.2); padding: 4px 10px; border-radius: 100px; }
  /* Reuse standard agent layout styles */
  .agent-detail-page { background: var(--color-bg); min-height: 100vh; }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 5%; }
  .section-light { padding: 5rem 0; background: var(--color-bg); border-bottom: 1px solid var(--color-line); }
  .section-dark { padding: 6rem 0; background: #060e0b; color: #f1ece0; border-bottom: 1px solid rgba(245,158,11,.15); }
  
  .content-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 4rem; }
  @media (max-width: 900px) { .content-grid { grid-template-columns: 1fr; gap: 3rem; } }

  .agent-hero { background: #060e0b; padding: 3rem 0 5rem; border-bottom: 1px solid rgba(245,158,11,.15); color: #f1ece0; }
  .breadcrumb { margin-bottom: 3rem; }
  .breadcrumb a { font-size: 0.85rem; color: rgba(241,236,224,.5); text-decoration: none; transition: color 200ms ease; }
  .breadcrumb a:hover { color: #f59e0b; }

