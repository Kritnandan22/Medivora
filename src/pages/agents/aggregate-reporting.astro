            <tr><td>Data/narrative mismatch</td><td class="risk-high">Critical</td><td class="risk-med">Medium</td><td>Validation agent cross-checks numbers vs. text</td><td class="risk-low">Low</td></tr>
            <tr><td>Lost-in-the-middle effect</td><td class="risk-high">High</td><td class="risk-high">High</td><td>Map-reduce chunking architecture</td><td class="risk-med">Medium</td></tr>
