---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Intake & Triage Agent Demo"
  description="Live demonstration of the Medivora Intake & Triage Agent parsing unstructured ICSR data."
>
  <section class="demo-hero">
    <div class="wrap">
      <h1>Intake & Triage <em>Agent Demo</em></h1>
      <p class="demo-lede">
        Paste a raw, unstructured email or clinical narrative below. The local agent will use LLM parsing to extract the E2B(R3) standard elements and validate the case criteria.
      </p>
    </div>
  </section>

  <section class="demo-workspace">
    <div class="wrap split-layout">
      
      <!-- Input Column -->
      <div class="demo-col input-col">
        <h3>Source Document</h3>
        <textarea id="source-text" placeholder="e.g. Dear Pharmacovigilance Team, I am a 45-year-old male from the UK. I took Aspirin 100mg for a headache yesterday, and within two hours I developed a severe allergic skin rash. Please advise."></textarea>
        <div class="controls">
          <button id="run-agent-btn" class="btn btn-primary">Run Extraction Agent</button>
          <span id="agent-status" class="status-msg"></span>
        </div>
      </div>

      <!-- Output Column -->
      <div class="demo-col output-col">
        <div class="output-header">
          <h3>Structured Output (JSON)</h3>
          <div id="validity-badge" class="badge">Awaiting Input</div>
        </div>
        <pre id="json-output">Run the agent to see extracted E2B(R3) data...</pre>
        <div id="reasoning-box" class="reasoning-box" hidden>
          <strong>Validation Reasoning:</strong> <span id="reasoning-text"></span>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .demo-hero {
    padding: 6rem 0 3rem;
    text-align: center;
  }
  .demo-hero h1 {
    font-family: var(--font-serif);
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  .demo-lede {
    font-size: 1.1rem;
    color: var(--color-text-soft);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .split-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding-bottom: 6rem;
  }
  @media (max-width: 768px) {
    .split-layout { grid-template-columns: 1fr; }
  }
  .demo-col {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .demo-col h3 {
    font-size: 1.2rem;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
  }
  textarea {
    width: 100%;
    min-height: 300px;
    background: rgba(0,0,0,0.2);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    padding: 1rem;
    font-family: var(--font-sans);
    resize: vertical;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .status-msg {
    font-size: 0.9rem;
    color: var(--color-text-soft);
  }
  .output-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .badge {
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    background: var(--color-line);
    color: var(--color-text-soft);
  }
  .badge.valid {
    background: rgba(34, 197, 94, 0.2);
    color: #4ade80;
    border: 1px solid #4ade80;
  }
  .badge.invalid {
    background: rgba(239, 68, 68, 0.2);
    color: #f87171;
    border: 1px solid #f87171;
  }
  pre {
    background: #0f1115;
    padding: 1rem;
    border-radius: var(--radius-sm);
    overflow-x: auto;
    font-family: monospace;
    font-size: 0.85rem;
    color: #a5b4fc;
    min-height: 300px;
  }
  .reasoning-box {
    margin-top: 1rem;
    padding: 1rem;
    background: rgba(255,255,255,0.05);
    border-left: 3px solid var(--color-accent);
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const runBtn = document.getElementById("run-agent-btn");
    const statusMsg = document.getElementById("agent-status");
    const jsonOutput = document.getElementById("json-output");
    const validityBadge = document.getElementById("validity-badge");
    const sourceText = document.getElementById("source-text");
    const reasoningBox = document.getElementById("reasoning-box");
    const reasoningText = document.getElementById("reasoning-text");

    runBtn.addEventListener("click", async () => {
      const text = sourceText.value.trim();
      if (!text) {
        statusMsg.textContent = "Please enter source text.";
        return;
      }

      statusMsg.textContent = "Running agent...";
      jsonOutput.textContent = "Processing... (Connecting to local FastAPI server on port 8000)";
      validityBadge.className = "badge";
      validityBadge.textContent = "Processing";
      reasoningBox.hidden = true;
      runBtn.disabled = true;

      try {
        const response = await fetch("http://localhost:8000/api/extract", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ source_text: text })
        });

        if (!response.ok) {
          const errorData = await response.json();
          throw new Error(errorData.detail || "API Request Failed");
        }

        const data = await response.json();
        
        // Pretty print JSON
        jsonOutput.textContent = JSON.stringify(data, null, 2);
        
        // Update validity badge
        if (data.is_valid_case) {
          validityBadge.textContent = "Valid ICSR";
          validityBadge.className = "badge valid";
        } else {
          validityBadge.textContent = "Invalid ICSR";
          validityBadge.className = "badge invalid";
        }

        // Update reasoning
        if (data.validation_reasoning) {
          reasoningBox.hidden = false;
          reasoningText.textContent = data.validation_reasoning;
        }

        statusMsg.textContent = "Extraction complete.";
      } catch (error) {
        jsonOutput.textContent = `Error: ${error.message}\n\nMake sure the Python FastAPI server is running locally on port 8000 and GEMINI_API_KEY is set in the .env file.`;
        validityBadge.className = "badge invalid";
        validityBadge.textContent = "Error";
        statusMsg.textContent = "Failed.";
      } finally {
        runBtn.disabled = false;
      }
    });
  });
</script>
