---
import ContentLayout from '~/layouts/ContentLayout.astro';

const principles = [
  {
    num: 'i.',
    title: 'Validate to GVP Module VI',
    body: 'Every automated PV workflow — whether case intake or auto-coding — must be validated to perform exactly as intended under Good Pharmacovigilance Practices (GVP) and 21 CFR Part 11. Computer Systems Validation (CSV) must adapt to algorithmic non-determinism, utilizing locked model weights during validation.',
    code: 'GVP Module VI · 21 CFR Part 11',
  },
  {
    num: 'ii.',
    title: 'E2B (R3) Audit Trails',
    body: 'Signed steps, immutable history, and strict adherence to ICH E2B (R3) data standards make an AI pipeline independently auditable. Regulators require an unbroken chain of custody showing exactly what data the AI ingested and what it outputted.',
    code: 'ICH E2B (R3)',
  },
  {
    num: 'iii.',
    title: 'Human-in-the-loop for Seriousness',
    body: 'Agents augment drug safety physicians; they don\'t replace them. The most credible systems route decisions of consequence — like Seriousness, Expectedness, and Causality — to a qualified human reviewer (QPPV). Automation handles the rote extraction, humans handle the medical judgement.',
    code: 'Medical Review',
  },
  {
    num: 'iv.',
    title: 'Grounding prevents Hallucinations',
    body: 'In adverse event extraction, LLM hallucinations are dangerous. Zero-shot generation must be replaced with strict semantic grounding (RAG architectures) and explicit source-text linking to ensure 100% factual accuracy before committing data to the safety database.',
    code: 'RAG · Semantic Grounding',
  },
  {
    num: 'v.',
    title: 'Algorithmic Traceability & Explainability',
    body: 'Black-box neural networks are unacceptable in regulatory environments. Every decision made by the AI (e.g., mapping a verbatim term to a MedDRA LLT) must be accompanied by an explainable "reasoning trace" that a human auditor can easily interpret.',
    code: 'XAI · Traceability',
  },
  {
    num: 'vi.',
    title: 'Data Privacy & Anonymisation',
    body: 'Processing patient narratives requires stringent adherence to HIPAA and GDPR. AI models must be deployed in secure, single-tenant or VPC environments, and Personally Identifiable Information (PII) must be deterministically de-identified before hitting any external reasoning endpoints.',
    code: 'HIPAA · GDPR',
  },
  {
    num: 'vii.',
    title: 'Continuous Drift Monitoring',
    body: 'Language models and data distributions shift over time. Continuous drift monitoring, automated regression testing against golden PV datasets, and periodic re-validation must be built in from inception, not retrofitted once a regulatory agency flags a missed signal.',
    code: 'QPPV Oversight',
  },
  {
    num: 'viii.',
    title: 'Shadow Mode Deployment',
    body: 'Before live production, AI agents should run in a "shadow mode" parallel to existing human workflows. This allows QPPVs to evaluate the agent\'s decisions against human benchmarks without risking compliance, ensuring the system meets a 99%+ accuracy threshold [10] before taking over.',
    code: 'Deployment Strategy',
  },
  {
    num: 'ix.',
    title: 'EU AI Act Compliance',
    body: 'Under the incoming EU AI Act, pharmacovigilance automation often qualifies as a high-risk AI system. Implementers must ensure rigorous risk management systems, high-quality data governance, logging capabilities, and human oversight measures are in place to meet regulatory conformity assessments.',
    code: 'EU AI Act (High-Risk)',
  }
];
---

<ContentLayout
  title="Responsible Adoption"
  description="The non-negotiables that separate a deployable AI system from a liability in Pharmacovigilance — validation, audit trails, human oversight, grounding, and governance."
  eyebrow="04 — Doing It Responsibly"
  heading='In Drug Safety, "it mostly works" <em>is not good enough.</em>'
  lede="Automation in Pharmacovigilance lives or dies on trust. These are the non-negotiables that separate a deployable system from a regulatory liability."
>

  <section class="resp-section">
    <div class="wrap">
      
      <div class="hero-image-container">
        <video src="/videos/hero-governance.mp4" poster="/og-default.png" preload="none" autoplay loop muted playsinline class="hero-image"></video>
      </div>

      <div class="resp-layout">

        <!-- Principles list -->
        <div class="resp-list">
          {principles.map((p) => (
            <div class="resp-row">
              <span class="resp-num">{p.num}</span>
              <div class="resp-content">
                <h2>{p.title}</h2>
                <p>
                  {p.body}
                  {p.code && <> <code>{p.code}</code></>}
                </p>
              </div>
            </div>
          ))}
        </div>

        <!-- Sticky aside -->
        <aside class="resp-aside">
          <span class="resp-aside-label">The honest takeaway</span>
          <blockquote>
            AI performs best when it automates <em>well-defined workflows</em> like data extraction — and falls short when asked to replace clinical judgement like <em>Seriousness</em> or <em>Expectedness</em>.
          </blockquote>
          <p>
            That single sentence explains the whole architecture of this guide: deterministic
            workflows for the structured majority, AI agents for the ambiguous unstructured data, and humans wherever the regulatory stakes are highest. Lasting progress comes from thoughtful integration into drug safety — not from early hype.
          </p>
        </aside>
      </div>

      <nav class="resp-nav">
        <a href="/case-studies" class="btn btn-ghost">← Case Studies</a>
        <a href="/road-ahead" class="btn btn-primary">The road ahead →</a>
      </nav>
    </div>
  </section>

</ContentLayout>

<style>
  .resp-section { padding: 3rem 0 5rem; }

  .hero-image-container {
    margin-bottom: 3rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .hero-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    max-height: 500px;
  }

  .resp-layout {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: start;
    margin-bottom: 3rem;
  }

  /* Principle rows */
  .resp-list { display: flex; flex-direction: column; gap: 0; }
  .resp-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.25rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--color-line-soft);
  }
  .resp-row:last-child { border-bottom: 0; }

  .resp-num {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-signal);
    padding-top: 4px;
    font-weight: 500;
  }
  .resp-content h2 {
    font-family: var(--font-serif);
    font-size: 1.22rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .resp-content p {
    font-size: 0.93rem;
    color: var(--color-text-soft);
    line-height: 1.55;
  }
  .resp-content code {
    font-family: var(--font-mono);
    font-size: 0.8em;
    background-color: var(--color-surface-2);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    color: var(--color-text-2);
  }

  /* Aside card */
  .resp-aside {
    background: linear-gradient(135deg, rgba(6, 14, 11, 0.9) 0%, rgba(13, 26, 21, 0.95) 100%);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(241, 236, 224, 0.1);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    color: #f1ece0;
    border-radius: var(--radius-lg);
    padding: 3rem 2.5rem;
    position: sticky;
    top: 5.5rem;
  }
  :global([data-theme='dark']) .resp-aside {
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-line);
    color: var(--color-text);
  }
  .resp-aside-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-amber-bright);
  }
  .resp-aside blockquote {
    font-family: var(--font-serif);
    font-size: 1.48rem;
    line-height: 1.32;
    font-weight: 500;
    margin: 1.1rem 0;
    letter-spacing: -0.01em;
    color: #f1ece0;
  }
  :global([data-theme='dark']) .resp-aside blockquote { color: var(--color-text); }
  .resp-aside blockquote em {
    font-style: italic;
    color: var(--color-green-bright);
  }
  .resp-aside p {
    font-size: 0.92rem;
    color: rgba(241,236,224,.76);
    line-height: 1.58;
  }
  :global([data-theme='dark']) .resp-aside p { color: var(--color-text-2); }

  /* Nav */
  .resp-nav { display: flex; gap: 1rem; flex-wrap: wrap; }

  @media (max-width: 860px) {
    .resp-layout { grid-template-columns: 1fr; }
    .resp-aside { position: static; }
  }
</style>
