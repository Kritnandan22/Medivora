---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import SearchOverlay from '~/components/SearchOverlay.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  dateModified?: string;
  isArticle?: boolean;
}

const {
  title,
  description = 'The definitive field guide to agentic AI in pharmacovigilance — automating the drug safety and ICSR lifecycle.',
  ogImage = '/og-default.png',
  dateModified = new Date().toISOString().split('T')[0],
  isArticle = false,
} = Astro.props;

const siteName = 'Medivora';
const fullTitle = title === siteName ? siteName : `${title} · ${siteName}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();

// JSON-LD WebSite & Organization schema
const baseJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: Astro.site?.toString(),
  description,
  inLanguage: 'en',
  publisher: {
    '@type': 'Organization',
    name: siteName,
    url: Astro.site?.toString(),
  },
};

// Optional Article schema
const articleJsonLd = isArticle ? {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description: description,
  author: {
    '@type': 'Person',
    name: 'Kritnandan'
  },
  publisher: {
    '@type': 'Organization',
    name: siteName,
  },
  dateModified: dateModified,
  datePublished: '2023-11-01', // Example initial publish date
} : null;

// Dynamically build BreadcrumbList schema
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
let breadcrumbJsonLd = null;
if (pathSegments.length > 0) {
  const itemListElement = [{
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: new URL('/', Astro.site).toString(),
  }];
  
  let currentPath = '';
  pathSegments.forEach((segment, index) => {
    currentPath += `/${segment}`;
    itemListElement.push({
      '@type': 'ListItem',
      position: index + 2,
      name: segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' '),
      item: new URL(currentPath, Astro.site).toString(),
    });
  });

  breadcrumbJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement
  };
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#0e6b54" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16a684" media="(prefers-color-scheme: dark)" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts — preconnect then load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Preload the primary display font to avoid FOUT -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(baseJsonLd)} />
    {articleJsonLd && <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />}
    {breadcrumbJsonLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}

    {/* Theme bootstrap — sets data-theme before first paint to avoid FOUC. */}
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark =
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          /* localStorage may be disabled; do nothing */
        }
      })();
    </script>
  </head>
  <body>
    <a id="top"></a>
    <a href="#main" class="skip-link">Skip to main content</a>

    <Header />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <style is:global>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background-color: var(--color-text);
        color: var(--color-bg);
        padding: 0.6rem 1rem;
        z-index: 100;
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        text-decoration: none;
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
      }
      /* Global focus ring */
      :focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
        border-radius: var(--radius-xs);
      }
    </style>
    <SearchOverlay />

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. Dynamic Sticky TOC for Agent Pages
        const isAgentPage = document.querySelector('article.agent-detail-page');
        if (isAgentPage) {
          const sections = Array.from(document.querySelectorAll('section[id]'));
          if (sections.length > 0) {
            // Create TOC container
            const toc = document.createElement('aside');
            toc.className = 'sticky-toc';
            toc.style.position = 'fixed';
            toc.style.right = '2rem';
            toc.style.top = '120px';
            toc.style.width = '220px';
            toc.style.zIndex = '50';
            
            const tocTitle = document.createElement('h4');
            tocTitle.textContent = 'On this page';
            toc.appendChild(tocTitle);
            
            const nav = document.createElement('nav');
            
            sections.forEach(sec => {
              const h2 = sec.querySelector('h2');
              if (h2) {
                const link = document.createElement('a');
                link.href = '#' + sec.id;
                link.textContent = h2.textContent;
                // Add click smooth scroll
                link.addEventListener('click', (e) => {
                  e.preventDefault();
                  sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
                  history.pushState(null, null, '#' + sec.id);
                });
                nav.appendChild(link);
              }
            });
            
            toc.appendChild(nav);
            document.body.appendChild(toc);
            
            // Intersection Observer for active state
            const observer = new IntersectionObserver(entries => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  nav.querySelectorAll('a').forEach(a => a.classList.remove('active'));
                  const activeLink = nav.querySelector(`a[href="#${entry.target.id}"]`);
                  if (activeLink) activeLink.classList.add('active');
                }
              });
            }, { rootMargin: '-100px 0px -60% 0px' });
            
            sections.forEach(sec => observer.observe(sec));
            
            // Adjust body padding to avoid overlapping with fixed TOC on wide screens
            if (window.innerWidth > 1200) {
              document.body.style.paddingRight = '240px';
            }
          }
        }
        
        // 2. Glossary Tooltips
        const glossaryTerms = {
          'ICSR': 'Individual Case Safety Report: A report of a suspected adverse event.',
          'MedDRA': 'Medical Dictionary for Regulatory Activities: Highly specific standardised medical terminology.',
          'PSUR': 'Periodic Safety Update Report: A pharmacovigilance document submitted to agencies.',
          'SUSAR': 'Suspected Unexpected Serious Adverse Reaction: Requires expedited reporting.',
          'QPPV': 'Qualified Person for Pharmacovigilance: Personally responsible for PV system compliance.',
          'E2B': 'ICH standard for the electronic transmission of ICSRs.',
          'RAG': 'Retrieval-Augmented Generation: AI technique combining search with LLM reasoning.',
          'LLT': 'Lowest Level Term: The most specific tier in the MedDRA hierarchy.',
          'SOC': 'System Organ Class: The highest tier in the MedDRA hierarchy.'
        };
        
        const paragraphs = document.querySelectorAll('p, li');
        paragraphs.forEach(p => {
          // Skip if already in a code block or pre
          if (p.closest('pre') || p.closest('code') || p.closest('.no-glossary')) return;
          
          let html = p.innerHTML;
          let changed = false;
          
          Object.keys(glossaryTerms).forEach(term => {
            // Regex to match term (word boundary) not inside an HTML tag
            const regex = new RegExp(`\\b(${term})\\b(?![^<]*>)`, 'g');
            if (regex.test(html)) {
              html = html.replace(regex, `<abbr class="glossary-term" data-definition="${glossaryTerms[term]}">$1</abbr>`);
              changed = true;
            }
          });
          
          if (changed) p.innerHTML = html;
        });
      });
    </script>
  </body>
</html>
